new file mode 100644
index 0000000000000000000000000000000000000000..4e1e34649b360b317a2f74827ec6a0ad28057ea1
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/doze/DozeSuspendDrawController.java
@@ -0,0 +1,222 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.doze;
+
+import android.content.Context;
+import android.hardware.SyncFence;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.PowerManager;
+import android.util.Log;
+import android.view.Display;
+import android.view.SurfaceControl;
+import android.view.View;
+import android.view.ViewRootImpl;
+import android.view.ViewTreeObserver;
+
+import com.android.systemui.dagger.SysUISingleton;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.res.R;
+import com.android.window.flags.Flags;
+
+import java.time.Duration;
+import java.util.concurrent.Executor;
+
+import javax.inject.Inject;
+
+/** Optional draw lease for panels which must present a frame before entering suspend. */
+@SysUISingleton
+public final class DozeSuspendDrawController implements View.OnAttachStateChangeListener,
+        ViewTreeObserver.OnPreDrawListener, DisplayManager.DisplayListener {
+    private static final String TAG = "DozeSuspendDraw";
+    // Failure bounds only. Successful frames release the lock as soon as they are presented.
+    private static final long FAILURE_TIMEOUT_MS = 3000;
+    private static final Duration FENCE_TIMEOUT = Duration.ofSeconds(1);
+    private final boolean mEnabled;
+    private final DisplayManager mDisplays;
+    private final Handler mHandler;
+    private final Executor mBackgroundExecutor;
+    private final PowerManager.WakeLock mDrawLock;
+    private View mView;
+    private ViewTreeObserver mObserver;
+    private boolean mTargetSuspend;
+    private boolean mListening;
+    private boolean mHeld;
+    private boolean mFailed;
+    private long mGeneration;
+    private long mFrame;
+    private Runnable mTimeout;
+
+    @Inject
+    public DozeSuspendDrawController(Context context, PowerManager powerManager,
+            DisplayManager displays, @Main Handler handler, @Background Executor executor) {
+        mEnabled = context.getResources().getBoolean(R.bool.doze_present_before_suspend)
+                && Flags.sdkDesiredPresentTime();
+        mDisplays = displays;
+        mHandler = handler;
+        mBackgroundExecutor = executor;
+        mDrawLock = mEnabled
+                ? powerManager.newWakeLock(PowerManager.DRAW_WAKE_LOCK, TAG) : null;
+        if (mDrawLock != null) mDrawLock.setReferenceCounted(false);
+    }
+
+    public void setView(View view) {
+        if (!mEnabled || mView == view) return;
+        stopListening();
+        release();
+        if (mView != null) mView.removeOnAttachStateChangeListener(this);
+        mView = view;
+        mFailed = false;
+        if (mView != null) mView.addOnAttachStateChangeListener(this);
+        if (mTargetSuspend) prepare();
+    }
+
+    /** Called before DreamService submits its desired screen state. */
+    public void setScreenState(int state) {
+        if (!mEnabled) return;
+        mTargetSuspend = state == Display.STATE_DOZE_SUSPEND;
+        if (mTargetSuspend) {
+            prepare();
+        } else {
+            stopListening();
+            release();
+            mFailed = false;
+        }
+    }
+
+    private void prepare() {
+        if (mFailed || mView == null || !mView.isAttachedToWindow()) return;
+        if (!mListening) {
+            mObserver = mView.getViewTreeObserver();
+            mObserver.addOnPreDrawListener(this);
+            // A16 can deliver committed-state changes separately from ordinary state changes.
+            mDisplays.registerDisplayListener(this, mHandler,
+                    DisplayManager.EVENT_TYPE_DISPLAY_CHANGED
+                            | DisplayManager.EVENT_TYPE_DISPLAY_REMOVED,
+                    DisplayManager.PRIVATE_EVENT_TYPE_DISPLAY_COMMITTED_STATE_CHANGED);
+            mListening = true;
+        }
+        acquire();
+        invalidateWhenReady();
+    }
+
+    private void acquire() {
+        if (mHeld) return;
+        mDrawLock.acquire();
+        mHeld = true;
+        final long generation = ++mGeneration;
+        mTimeout = () -> {
+            if (mHeld && generation == mGeneration) {
+                Log.w(TAG, "AOD frame did not complete; releasing draw lease");
+                fail();
+            }
+        };
+        mHandler.postDelayed(mTimeout, FAILURE_TIMEOUT_MS);
+    }
+
+    private boolean ready() {
+        final Display display = mView == null ? null : mView.getDisplay();
+        return display != null && display.getCommittedState() == Display.STATE_DOZE;
+    }
+
+    private void invalidateWhenReady() {
+        if (mHeld && ready()) mView.invalidate();
+    }
+
+    @Override
+    public boolean onPreDraw() {
+        if (!mTargetSuspend || !mListening || mFailed) return true;
+        // Also protect natural AOD updates (clock/notification), not a periodic forced refresh.
+        acquire();
+        if (!ready()) return false;
+        final ViewRootImpl root = mView.getViewRootImpl();
+        if (root == null || !mView.isHardwareAccelerated()) {
+            Log.w(TAG, "No hardware AOD window; releasing draw lease");
+            fail();
+            return true;
+        }
+        final long generation = mGeneration;
+        final long frame = ++mFrame;
+        try (SurfaceControl.Transaction transaction = new SurfaceControl.Transaction()) {
+            transaction.addTransactionCompletedListener(mBackgroundExecutor, stats -> {
+                boolean presented = false;
+                try (SyncFence fence = stats.getPresentFence()) {
+                    presented = stats.getLatchTimeNanos() > 0 && fence.isValid()
+                            && fence.await(FENCE_TIMEOUT)
+                            && fence.getSignalTime() >= 0
+                            && fence.getSignalTime() != SyncFence.SIGNAL_TIME_PENDING;
+                } catch (RuntimeException exception) {
+                    Log.w(TAG, "Cannot observe AOD present fence", exception);
+                }
+                final boolean success = presented;
+                mHandler.post(() -> {
+                    // Late completions must not release a newer draw or a later AOD session.
+                    if (mHeld && mGeneration == generation && mFrame == frame) {
+                        if (success) {
+                            release();
+                        } else {
+                            Log.w(TAG, "AOD present fence missing or failed");
+                            fail();
+                        }
+                    }
+                });
+            });
+            // Merge with this window's actual next buffer; an empty standalone transaction
+            // or a committed callback alone does not prove the AOD frame was presented.
+            root.applyTransactionOnDraw(transaction);
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Cannot attach AOD completion to draw", exception);
+            fail();
+        }
+        return true;
+    }
+
+    private void release() {
+        ++mGeneration;
+        if (mTimeout != null) mHandler.removeCallbacks(mTimeout);
+        mTimeout = null;
+        if (mHeld) {
+            mHeld = false;
+            mDrawLock.release();
+        }
+    }
+
+    private void fail() {
+        // Do not turn failed/repeated pre-draw callbacks into an endless wake-lock retry loop.
+        mFailed = true;
+        stopListening();
+        release();
+    }
+
+    private void stopListening() {
+        if (!mListening) return;
+        mListening = false;
+        mDisplays.unregisterDisplayListener(this);
+        if (mObserver != null && mObserver.isAlive()) mObserver.removeOnPreDrawListener(this);
+        mObserver = null;
+    }
+
+    @Override public void onViewAttachedToWindow(View view) {
+        mFailed = false;
+        if (mTargetSuspend) prepare();
+    }
+    @Override public void onViewDetachedFromWindow(View view) {
+        stopListening();
+        release();
+    }
+    @Override public void onDisplayAdded(int id) { }
+    @Override public void onDisplayChanged(int id) {
+        if (mView != null && mView.getDisplay() != null
+                && mView.getDisplay().getDisplayId() == id) invalidateWhenReady();
+    }
+    @Override public void onDisplayRemoved(int id) {
+        if (mView == null || mView.getDisplay() == null
+                || mView.getDisplay().getDisplayId() == id) {
+            stopListening();
+            release();
+        }
+    }
+}
