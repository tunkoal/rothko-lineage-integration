+        mDisplay.timeAdvance();
+        assertThat(mChanges).containsExactly(true, false).inOrder();
+    }
+
+    @Test
+    public void stalledWorkerCannotKeepPermissionPastLease() {
+        mSafety.start();
+        drain();
+
+        mClock.fastForward(HdrThermalSafety.MAX_SAMPLE_AGE_MILLIS + 1);
+        mDisplay.timeAdvance();
+        assertThat(mChanges).containsExactly(true, false).inOrder();
+    }
+
+    @Test
+    public void remoteFailureRevokesPermission() throws Exception {
+        mSafety.start();
+        drain();
+        when(mHal.getTemperatures()).thenThrow(new RemoteException());
+
+        mClock.fastForward(HdrThermalSafety.POLL_INTERVAL_MILLIS + 1);
+        drain();
+        assertThat(mChanges).containsExactly(true, false).inOrder();
+    }
+
+    @Test
+    public void disappearingSensorDoesNotGrantFromPartialNoneSnapshot() throws Exception {
+        mSafety.start();
+        drain();
+        when(mHal.getTemperatures()).thenReturn(new Temperature[]{snapshot(0)[0]});
+        mClock.fastForward(HdrThermalSafety.POLL_INTERVAL_MILLIS + 1);
+        drain();
+        assertThat(mChanges).containsExactly(true, false).inOrder();
+    }
+
+    @Test
+    public void thermalEventDuringSnapshotCannotGrantFromSupersededResult() throws Exception {
+        int[] calls = {0};
+        when(mHal.getTemperatures()).thenAnswer(invocation -> {
+            if (calls[0]++ == 0) {
+                mCallback.notifyThrottling(snapshot(1)[0]);
+                return snapshot(0);
+            }
+            return snapshot(1);
+        });
+        mSafety.start();
+        drain();
+        assertThat(mChanges).isEmpty();
+    }
+
+    @Test
+    public void stoppedObserverRejectsPendingSuccessDelivery() {
+        mSafety.start();
+        mWorker.timeAdvance();
+        mSafety.stop();
+        mDisplay.timeAdvance();
+        assertThat(mChanges).isEmpty();
+    }
+
+    @Test
+    public void rejectsNaNMissingSkinAndInvalidStatuses() {
+        Temperature[] values = snapshot(0);
+        values[0].value = Float.NaN;
+        assertThat(HdrThermalSafety.isValidSnapshot(values, new HashSet<>())).isFalse();
+        assertThat(HdrThermalSafety.isValidSnapshot(
+                new Temperature[]{snapshot(0)[1]}, new HashSet<>())).isFalse();
+        values = snapshot(-1);
+        assertThat(HdrThermalSafety.isValidSnapshot(values, new HashSet<>())).isFalse();
+    }
+
+    private void drain() {
+        mWorker.timeAdvance();
+        mDisplay.timeAdvance();
+    }
+
+    private static Temperature[] snapshot(int status) {
+        Temperature skin = new Temperature();
+        skin.type = TemperatureType.SKIN;
+        skin.name = "skin";
+        skin.value = 35;
+        skin.throttlingStatus = status;
+        Temperature battery = new Temperature();
+        battery.type = TemperatureType.BATTERY;
+        battery.name = "battery";
+        battery.value = 30;
+        battery.throttlingStatus = 0;
+        return new Temperature[]{skin, battery};
+    }
