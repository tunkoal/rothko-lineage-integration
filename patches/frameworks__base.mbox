+package android.hardware.face;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import android.hardware.biometrics.SensorProperties;
+import android.os.Parcel;
+import android.platform.test.annotations.Presubmit;
+
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+@Presubmit
+@SmallTest
+public class FaceSensorPropertiesInternalTest {
+    @Test
+    public void typedListRoundTrip_preservesPreviewAndNextElement() {
+        final FaceSensorPropertiesInternal hal = new FaceSensorPropertiesInternal(8,
+                SensorProperties.STRENGTH_CONVENIENCE, 2, Collections.emptyList(),
+                FaceSensorProperties.TYPE_RGB, false, true, false,
+                true, 0, 480, 640, 100f, 50f, 1f);
+        final FaceSensorPropertiesInternal legacy = new FaceSensorPropertiesInternal(9,
+                SensorProperties.STRENGTH_WEAK, 1, Collections.emptyList(),
+                FaceSensorProperties.TYPE_IR, true, true, true);
+        final Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeTypedList(Arrays.asList(hal, legacy));
+            parcel.writeInt(12345);
+            parcel.setDataPosition(0);
+            final List<FaceSensorPropertiesInternal> restored = parcel.createTypedArrayList(
+                    FaceSensorPropertiesInternal.CREATOR);
+            assertThat(restored).hasSize(2);
+            final FaceSensorPropertiesInternal preview = restored.get(0);
+            assertThat(preview.sensorId).isEqualTo(8);
+            assertThat(preview.sensorStrength).isEqualTo(SensorProperties.STRENGTH_CONVENIENCE);
+            assertThat(preview.halControlsPreview).isTrue();
+            assertThat(preview.enrollPreviewWidth).isEqualTo(480);
+            assertThat(preview.enrollPreviewHeight).isEqualTo(640);
+            assertThat(preview.enrollTranslationX).isEqualTo(100f);
+            assertThat(preview.enrollTranslationY).isEqualTo(50f);
+            assertThat(preview.enrollPreviewScale).isEqualTo(1f);
+            final FaceSensorPropertiesInternal fallback = restored.get(1);
+            assertThat(fallback.sensorId).isEqualTo(9);
+            assertThat(fallback.supportsSelfIllumination).isTrue();
+            assertThat(fallback.resetLockoutRequiresChallenge).isTrue();
+            assertThat(fallback.halControlsPreview).isFalse();
+            assertThat(fallback.enrollPreviewWidth).isEqualTo(0);
+            assertThat(fallback.enrollPreviewHeight).isEqualTo(0);
+            assertThat(fallback.enrollPreviewScale).isEqualTo(1f);
+            assertThat(parcel.readInt()).isEqualTo(12345);
+        } finally {
+            parcel.recycle();
+        }
+    }
+}
