+package com.android.server.display.brightness.clamper;
+
+import android.annotation.Nullable;
+import android.hardware.thermal.IThermal;
+import android.hardware.thermal.IThermalChangedCallback;
+import android.hardware.thermal.Temperature;
+import android.hardware.thermal.TemperatureThreshold;
+import android.hardware.thermal.TemperatureType;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SystemClock;
+
+import com.android.internal.annotations.VisibleForTesting;
+
+import java.io.PrintWriter;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Consumer;
+
+/**
+ * Optional conservative HDR boost gate using the device's existing Thermal AIDL policy.
+ *
+ * No temperature thresholds or brightness limits are inferred here. Every returned temperature
+ * must be valid and report NONE, and at least one SKIN sensor must be present. Thermal policy and
+ * mitigation remain owned by the HAL. Binder calls run on a private worker; the display handler
+ * expires permission even if that worker is blocked in an unresponsive HAL.
+ */
+final class HdrThermalSafety {
+    @VisibleForTesting static final long POLL_INTERVAL_MILLIS = 1000;
+    @VisibleForTesting static final long MAX_SAMPLE_AGE_MILLIS = 2500;
+
+    private final Handler mDisplayHandler;
+    private final Handler mWorker;
+    @Nullable private final HandlerThread mThread;
+    private final Consumer<Boolean> mListener;
+    private final Injector mInjector;
+    private final AtomicLong mEpoch = new AtomicLong();
+    private final Set<String> mExpectedSensors = new HashSet<>();
+    private final Runnable mPoll = this::poll;
+    private final Runnable mExpiry = () -> setAllowed(false, "sample expired");
+
+    private volatile boolean mStarted;
+    private boolean mAllowed; // Display handler only.
+    private String mReason = "not started"; // Display handler only.
+    private long mLastSampleTime; // Display handler only.
+    @Nullable private IThermal mHal; // Worker only.
+    @Nullable private IBinder.DeathRecipient mDeathRecipient; // Worker only.
+    @Nullable private IThermalChangedCallback mCallback; // Worker only.
+
+    HdrThermalSafety(Handler displayHandler, Consumer<Boolean> listener) {
+        this(displayHandler, listener, new Injector());
+    }
+
+    private HdrThermalSafety(Handler displayHandler, Consumer<Boolean> listener, Injector injector) {
+        mDisplayHandler = displayHandler;
+        mListener = listener;
+        mInjector = injector;
+        mThread = new HandlerThread("HdrThermalSafety");
+        mThread.start();
+        mWorker = new Handler(mThread.getLooper());
+    }
+
+    @VisibleForTesting
+    HdrThermalSafety(Handler displayHandler, Handler worker, Consumer<Boolean> listener,
+            Injector injector) {
+        mDisplayHandler = displayHandler;
+        mWorker = worker;
+        mListener = listener;
+        mInjector = injector;
+        mThread = null;
+    }
+
+    // Called on the display handler.
+    void start() {
+        if (mStarted) {
+            return;
+        }
+        mStarted = true;
+        setAllowed(false, "awaiting thermal snapshot");
+        mWorker.post(mPoll);
+    }
+
+    // Called on the display handler. Each instance has one lifecycle.
+    void stop() {
+        mStarted = false;
+        mEpoch.incrementAndGet();
+        mDisplayHandler.removeCallbacks(mExpiry);
+        setAllowed(false, "stopped");
+        mWorker.removeCallbacks(mPoll);
+        mWorker.post(() -> {
+            disconnect();
+            if (mThread != null) {
+                mThread.quitSafely();
+            }
+        });
+    }
+
+    // Called on the display handler, including on the first brightness update after suspend.
+    boolean isAllowed() {
+        if (mAllowed && mInjector.elapsedRealtime() - mLastSampleTime >= MAX_SAMPLE_AGE_MILLIS) {
+            setAllowed(false, "sample expired across suspend");
+        }
+        return mStarted && mAllowed;
+    }
+
+    void dump(PrintWriter pw) {
+        pw.println("  HdrThermalSafety: started=" + mStarted + ", allowed=" + mAllowed
+                + ", reason=" + mReason + ", lastSampleTime=" + mLastSampleTime);
+    }
+
+    private void setAllowed(boolean allowed, String reason) {
+        mReason = reason;
+        if (mAllowed != allowed) {
+            mAllowed = allowed;
+            mListener.accept(allowed);
+        }
+    }
+
+    // The epoch prevents an in-flight sample from granting permission after a callback/death/stop.
+    private void invalidate(String reason) {
+        mEpoch.incrementAndGet();
+        mDisplayHandler.post(() -> {
+            mDisplayHandler.removeCallbacks(mExpiry);
+            setAllowed(false, reason);
+        });
+    }
+
+    private void refreshAfterEvent() {
+        mWorker.post(() -> {
+            if (mStarted) {
+                mWorker.removeCallbacks(mPoll);
+                mWorker.post(mPoll);
+            }
+        });
+    }
+
+    // Worker only. Register before sampling so a status change cannot be missed between them.
+    private boolean connect() throws RemoteException {
+        IThermal hal = mInjector.getThermalHal();
+        if (hal == null) {
+            return false;
+        }
+        IBinder binder = hal.asBinder();
+        IBinder.DeathRecipient death = () -> {
+            invalidate("thermal HAL died");
+            mWorker.post(() -> {
+                if (mHal == hal) {
+                    disconnect();
+                }
+                if (mStarted) {
+                    mWorker.removeCallbacks(mPoll);
+                    mWorker.post(mPoll);
+                }
+            });
+        };
+        IThermalChangedCallback callback = new IThermalChangedCallback.Stub() {
+            @Override
+            public void notifyThrottling(Temperature temperature) {
+                // Never grant from a callback alone: validate the complete current inventory.
+                invalidate("thermal event; resampling");
+                refreshAfterEvent();
+            }
+
+            @Override
+            public void notifyThresholdChanged(TemperatureThreshold threshold) {
+                invalidate("thermal thresholds changed; resampling");
+                refreshAfterEvent();
+            }
+
+            @Override
+            public int getInterfaceVersion() {
+                return VERSION;
+            }
+
+            @Override
+            public String getInterfaceHash() {
+                return HASH;
+            }
+        };
+        mHal = hal;
+        mDeathRecipient = death;
+        mCallback = callback;
+        binder.linkToDeath(death, 0);
+        hal.registerThermalChangedCallback(callback);
+        return true;
+    }
+
+    private void disconnect() {
+        IThermal hal = mHal;
+        IBinder.DeathRecipient death = mDeathRecipient;
+        IThermalChangedCallback callback = mCallback;
+        mHal = null;
+        mDeathRecipient = null;
+        mCallback = null;
+        // Keep the observed built-in inventory across HAL restarts: a partial new
+        // instance must not silently drop a previously monitored sensor.
+        if (hal != null) {
+            if (death != null) {
+                try {
+                    hal.asBinder().unlinkToDeath(death, 0);
+                } catch (RuntimeException ignored) {
+                    // It may already have been unlinked by binder death.
+                }
+            }
+            if (callback != null) {
+                try {
+                    hal.unregisterThermalChangedCallback(callback);
+                } catch (RemoteException | RuntimeException ignored) {
+                    // Already closed or dead. The permission was revoked before disconnecting.
+                }
+            }
+        }
+    }
+
+    private void poll() {
+        if (!mStarted) {
+            return;
+        }
+        try {
+            if (mHal == null && !connect()) {
+                invalidate("thermal HAL unavailable");
+                return;
+            }
+            final IThermal hal = mHal;
+            if (hal == null) {
+                invalidate("thermal HAL unavailable");
+                return;
+            }
+            final long epoch = mEpoch.get();
+            final long started = mInjector.elapsedRealtime();
+            final Temperature[] temperatures = hal.getTemperatures();
+            final long completed = mInjector.elapsedRealtime();
+            final Set<String> sensors = new HashSet<>();
+            final boolean valid = isValidSnapshot(temperatures, sensors)
+                    && sensors.containsAll(mExpectedSensors)
+                    && completed - started <= MAX_SAMPLE_AGE_MILLIS;
+            if (!valid || !mStarted || epoch != mEpoch.get()) {
+                invalidate("thermal snapshot invalid, incomplete or superseded");
+                return;
+            }
+            mExpectedSensors.addAll(sensors);
+            boolean allowed = true;
+            for (Temperature temperature : temperatures) {
+                allowed &= temperature.throttlingStatus == android.os.Temperature.THROTTLING_NONE;
+            }
+            final boolean permit = allowed;
+            mDisplayHandler.post(() -> {
+                if (!mStarted || epoch != mEpoch.get()) {
+                    return;
+                }
+                // Expire an old permission before delivering a new successful sample.
+                isAllowed();
+                mLastSampleTime = completed;
+                mDisplayHandler.removeCallbacks(mExpiry);
+                if (mInjector.elapsedRealtime() - completed >= MAX_SAMPLE_AGE_MILLIS) {
+                    setAllowed(false, "sample expired before delivery");
+                    return;
+                }
+                setAllowed(permit, permit ? "fresh unthrottled snapshot" : "HAL throttling");
+                mDisplayHandler.postDelayed(mExpiry, Math.max(0,
+                        MAX_SAMPLE_AGE_MILLIS - (mInjector.elapsedRealtime() - completed)));
+            });
+        } catch (RemoteException | RuntimeException e) {
+            invalidate("thermal read failed");
+            disconnect();
+        } finally {
+            if (mStarted) {
+                mWorker.postDelayed(mPoll, POLL_INTERVAL_MILLIS);
+            }
+        }
+    }
+
+    @VisibleForTesting
+    static boolean isValidSnapshot(@Nullable Temperature[] temperatures, Set<String> sensors) {
+        if (temperatures == null || temperatures.length == 0) {
+            return false;
+        }
+        boolean hasSkin = false;
+        for (Temperature temperature : temperatures) {
+            if (temperature == null || temperature.name == null || temperature.name.isEmpty()
+                    || !Float.isFinite(temperature.value)
+                    || !android.os.Temperature.isValidStatus(temperature.throttlingStatus)
+                    || !sensors.add(temperature.type + ":" + temperature.name)) {
+                return false;
+            }
+            hasSkin |= temperature.type == TemperatureType.SKIN;
+        }
+        return hasSkin;
+    }
+
+    static class Injector {
+        @Nullable IThermal getThermalHal() {
+            // Non-blocking lookup: an absent service leaves the gate closed and will be retried.
+            return IThermal.Stub.asInterface(ServiceManager.checkService(
+                    IThermal.DESCRIPTOR + "/default"));
+        }
+
+        long elapsedRealtime() {
+            return SystemClock.elapsedRealtime();
+        }
+    }
+}
