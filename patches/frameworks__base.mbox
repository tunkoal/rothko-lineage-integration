+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display;
+
+/** Conversion between the affine logical/raw ranges used by a normal DDC brightness map. */
+final class BrightnessBacklightRange {
+    static boolean isValid(float min, float max) {
+        return Float.isFinite(min) && Float.isFinite(max) && min >= 0 && max <= 1 && min < max;
+    }
+
+    /** Preserve the HAL input, clamping only if the new physical range cannot represent it. */
+    static float convert(float brightness, float oldMin, float oldMax, float newMin, float newMax) {
+        if (!isValid(oldMin, oldMax) || !isValid(newMin, newMax)
+                || !Float.isFinite(brightness) || brightness < 0 || brightness > 1) {
+            return Float.NaN;
+        }
+        if (oldMin == newMin && oldMax == newMax) return brightness;
+        float raw = oldMin + brightness * (oldMax - oldMin);
+        return Math.max(0, Math.min(1, (raw - newMin) / (newMax - newMin)));
+    }
+}
