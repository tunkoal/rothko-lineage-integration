diff --git a/services/core/java/com/android/server/display/brightness/clamper/DeviceBrightnessModifier.java b/services/core/java/com/android/server/display/brightness/clamper/DeviceBrightnessModifier.java
new file mode 100644
index 0000000000000000000000000000000000000000..c8559906f10d20756bf7c7a0c496e87fcd32fd1e
--- /dev/null
+++ b/services/core/java/com/android/server/display/brightness/clamper/DeviceBrightnessModifier.java
@@ -0,0 +1,127 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display.brightness.clamper;
+
+import android.content.Context;
+import android.hardware.display.BrightnessInfo;
+import android.hardware.display.DisplayManagerInternal;
+import android.os.Handler;
+import android.os.PowerManager;
+import android.view.Display;
+
+import com.android.server.display.DisplayBrightnessState;
+import com.android.server.display.DisplayDeviceConfig;
+import com.android.server.display.brightness.BrightnessReason;
+import com.android.server.display.brightness.DeviceBrightnessPolicy;
+
+import java.io.PrintWriter;
+
+/** Device policy contributes one common bound before both SDR and HDR calculation. */
+final class DeviceBrightnessModifier implements BrightnessStateModifier,
+        BrightnessClamperController.DisplayDeviceDataListener,
+        BrightnessClamperController.StatefulModifier {
+    private final BrightnessClamperController.ClamperChangeListener mListener;
+    private final DeviceBrightnessPolicy mPolicy;
+    private DisplayDeviceConfig mConfig;
+    private float mCap = PowerManager.BRIGHTNESS_MAX;
+    private boolean mStopped;
+
+    DeviceBrightnessModifier(Context context, Handler handler,
+            BrightnessClamperController.ClamperChangeListener listener,
+            BrightnessClamperController.DisplayDeviceData data) {
+        mListener = listener;
+        mConfig = data.mDisplayDeviceConfig;
+        mPolicy = data.mDisplayId == Display.DEFAULT_DISPLAY
+                ? DeviceBrightnessPolicy.create(context, handler,
+                        () -> handler.post(this::updateCap)) : null;
+        updateCap();
+        if (mPolicy != null) handler.post(() -> {
+            if (!mStopped) mListener.onChanged();
+        });
+    }
+
+    private void updateCap() {
+        if (mStopped) return;
+        float cap = PowerManager.BRIGHTNESS_MAX;
+        if (mPolicy != null) {
+            float nits = mPolicy.getMaxBrightnessNits();
+            float[] map = mConfig.getNits();
+            if (nits != Float.POSITIVE_INFINITY) {
+                // A configured policy with invalid data cannot grant a higher bound.
+                cap = PowerManager.BRIGHTNESS_MIN;
+                if (Float.isFinite(nits) && nits >= 0 && map != null && map.length > 0) {
+                    float boundedNits = Math.max(map[0], Math.min(nits, map[map.length - 1]));
+                    float value = mConfig.getBrightnessFromBacklight(
+                            mConfig.getBacklightFromNits(boundedNits));
+                    if (Float.isFinite(value)) {
+                        cap = Math.max(PowerManager.BRIGHTNESS_MIN,
+                                Math.min(PowerManager.BRIGHTNESS_MAX, value));
+                    }
+                }
+            }
+        }
+        if (Float.compare(cap, mCap) != 0) {
+            mCap = cap;
+            mListener.onChanged();
+        }
+    }
+
+    @Override
+    public void onDisplayStateChanged(int state) {
+        if (mPolicy != null) mPolicy.setDisplayState(state);
+    }
+
+    @Override
+    public void apply(DisplayManagerInternal.DisplayPowerRequest request,
+            DisplayBrightnessState.Builder builder) {
+        if (mPolicy == null) return;
+        mPolicy.setAutomaticBrightness(request.useAutoBrightness);
+        updateCap(); // Also checks elapsed realtime after suspend, before applying any boost.
+        if (builder.getMaxBrightness() > mCap) {
+            builder.setMaxBrightness(mCap);
+            builder.setBrightnessMaxReason(BrightnessInfo.BRIGHTNESS_MAX_REASON_THERMAL);
+            builder.getBrightnessReason().addModifier(BrightnessReason.MODIFIER_THROTTLED);
+        }
+        if (builder.getBrightness() > mCap) {
+            builder.setBrightness(mCap);
+            builder.setIsSlowChange(false);
+        }
+    }
+
+    @Override
+    public void applyStateChange(BrightnessClamperController.ModifiersAggregatedState state) {
+        updateCap();
+        if (state.mMaxBrightness > mCap) {
+            state.mMaxBrightness = mCap;
+            state.mMaxBrightnessReason = BrightnessInfo.BRIGHTNESS_MAX_REASON_THERMAL;
+        }
+    }
+
+    @Override
+    public void onDisplayChanged(BrightnessClamperController.DisplayDeviceData data) {
+        mConfig = data.mDisplayDeviceConfig;
+        updateCap();
+    }
+
+    // Use DPC's already filtered automatic-brightness lux, without another ALS subscription/filter.
+    @Override public boolean shouldListenToLightSensor() { return false; }
+    @Override public void setAmbientLux(float lux) {
+        // This is the separate HDR/clamper light sensor, not the stock thermal table's input.
+    }
+    void setAutomaticBrightnessAmbientLux(float lux) {
+        if (mPolicy != null) {
+            mPolicy.setAmbientLux(lux);
+            updateCap();
+        }
+    }
+    @Override public void dump(PrintWriter writer) {
+        writer.println("DeviceBrightnessModifier: cap=" + mCap);
+        if (mPolicy != null) mPolicy.dump(writer);
+    }
+    @Override public void stop() {
+        mStopped = true;
+        if (mPolicy != null) mPolicy.stop();
+    }
+}

