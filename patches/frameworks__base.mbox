@@ -0,0 +1,77 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.doze;
+
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Handler;
+
+import com.android.systemui.util.wakelock.WakeLock;
+
+import java.util.function.Consumer;
+
+/** Adapts an opted-in special-trigger pickup sensor without changing its HAL metadata. */
+final class DozePickupListener {
+    private final SensorManager mManager;
+    private final Sensor mSensor;
+    private final Handler mHandler;
+    private final WakeLock mWakeLock;
+    private final Consumer<float[]> mCallback;
+    private SensorEventListener mListener;
+    private boolean mListening;
+    private long mGeneration;
+
+    DozePickupListener(SensorManager manager, Sensor sensor, Handler handler,
+            WakeLock wakeLock, Consumer<float[]> callback) {
+        if (sensor.getReportingMode() != Sensor.REPORTING_MODE_SPECIAL_TRIGGER
+                || !sensor.isWakeUpSensor()) {
+            throw new IllegalArgumentException("Pickup requires a wake-up special-trigger sensor");
+        }
+        mManager = manager;
+        mSensor = sensor;
+        mHandler = handler;
+        mWakeLock = wakeLock;
+        mCallback = callback;
+    }
+
+    // Called on the DozeSensors handler, just like the surrounding trigger registrations.
+    boolean setListening(boolean listen) {
+        if (mListening == listen) return mListening;
+        final long generation = ++mGeneration;
+        mListening = listen;
+        if (!listen) {
+            mManager.unregisterListener(mListener, mSensor);
+            mListener = null;
+            return false;
+        }
+        mListener = new SensorEventListener() {
+            @Override
+            public void onAccuracyChanged(Sensor sensor, int accuracy) {}
+
+            @Override
+            public void onSensorChanged(SensorEvent event) {
+                // The configured contract uses 1 for pickup. Put-down/other
+                // events must not wake the screen or force it back to sleep.
+                if (event.sensor != mSensor || event.values == null
+                        || event.values.length == 0 || event.values[0] != 1f) return;
+                final float[] values = event.values.clone();
+                mHandler.post(mWakeLock.wrap(() -> {
+                    // Disabling, changing users, or re-registering invalidates
+                    // both queued callbacks and events from the old listener.
+                    if (mListening && generation == mGeneration) mCallback.accept(values);
+                }));
+            }
+        };
+        if (!mManager.registerListener(mListener, mSensor,
+                SensorManager.SENSOR_DELAY_NORMAL, mHandler)) {
+            mListening = false;
+            mListener = null;
+            ++mGeneration;
+        }
+        return mListening;
+    }
+}
