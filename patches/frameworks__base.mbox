+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display;
+
+import android.content.Context;
+import android.util.Slog;
+
+/**
+ * Optional device doze backlight route. No panel commands or brightness values belong here.
+ *
+ * Constructed under the display lock: constructors must not perform IO. Apply/restore run in
+ * LocalDisplayAdapter's returned power-work Runnable, outside the global display lock, ordered
+ * with normal backlight and power commands. They must finish their commands before returning;
+ * queuing an unacknowledged write could change the panel after a later power transition.
+ * @hide
+ */
+public abstract class DeviceDozeBrightnessController {
+    public abstract boolean handlesDozeBrightness(int state);
+    public abstract void applyDozeBrightness(float brightness, float defaultDozeBrightness);
+    public abstract void onNormalBrightnessApplied();
+
+    public static DeviceDozeBrightnessController create(Context context, long physicalDisplayId) {
+        String name = context.getResources().getString(
+                com.android.internal.R.string.config_deviceSpecificDozeBrightnessController);
+        if (name == null || name.isEmpty()) return null;
+        try {
+            return Class.forName(name, true, DeviceDozeBrightnessController.class.getClassLoader())
+                    .asSubclass(DeviceDozeBrightnessController.class)
+                    .getConstructor(Context.class, long.class)
+                    .newInstance(context, physicalDisplayId);
+        } catch (ReflectiveOperationException | LinkageError | RuntimeException e) {
+            Slog.e("DeviceDozeBrightness", "Cannot load configured controller " + name, e);
+            return null;
+        }
+    }
+}
