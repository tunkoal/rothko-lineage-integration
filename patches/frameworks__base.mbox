new file mode 100644
index 0000000000000000000000000000000000000000..854c8c911c4d4a14a7dce6ad75ba187945fb42c4
--- /dev/null
+++ b/services/core/java/com/android/server/display/brightness/DeviceBrightnessPolicy.java
@@ -0,0 +1,57 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display.brightness;
+
+import android.content.Context;
+import android.os.Handler;
+import android.util.Slog;
+
+import java.io.PrintWriter;
+
+/**
+ * Optional device-owned thermal brightness policy. No panel values belong in this interface.
+ *
+ * All calls and the change callback run on the display handler. Implementations must keep disk,
+ * sysfs and Binder IO off that handler, expire stale input, and release their workers in stop().
+ * The device system-server jar must expose a (Context, Handler, Runnable) constructor.
+ * @hide
+ */
+public abstract class DeviceBrightnessPolicy {
+    public abstract void setDisplayState(int state);
+    public abstract void setAutomaticBrightness(boolean enabled);
+    public abstract void setAmbientLux(float lux);
+
+    /** Finite nonnegative nits cap; positive infinity means no additional cap. Never NaN. */
+    public abstract float getMaxBrightnessNits();
+    public abstract void dump(PrintWriter writer);
+    public abstract void stop();
+
+    /** An empty resource leaves upstream behavior unchanged on other devices. */
+    public static DeviceBrightnessPolicy create(Context context, Handler handler,
+            Runnable onChanged) {
+        String name = context.getResources().getString(
+                com.android.internal.R.string.config_deviceSpecificBrightnessPolicy);
+        if (name.isEmpty()) return null;
+        try {
+            return Class.forName(name, true, DeviceBrightnessPolicy.class.getClassLoader())
+                    .asSubclass(DeviceBrightnessPolicy.class)
+                    .getConstructor(Context.class, Handler.class, Runnable.class)
+                    .newInstance(context, handler, onChanged);
+        } catch (ReflectiveOperationException | LinkageError | RuntimeException e) {
+            // A device packaging error must not boot-loop system_server or permit extra boost.
+            Slog.e("DeviceBrightnessPolicy", "Cannot load configured brightness policy " + name, e);
+            return new DeviceBrightnessPolicy() {
+                public void setDisplayState(int state) { }
+                public void setAutomaticBrightness(boolean enabled) { }
+                public void setAmbientLux(float lux) { }
+                public float getMaxBrightnessNits() { return 0; }
+                public void dump(PrintWriter writer) {
+                    writer.println("Device brightness policy unavailable: " + name);
+                }
+                public void stop() { }
+            };
+        }
+    }
+}
