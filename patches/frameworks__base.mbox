@@ -0,0 +1,60 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.biometrics.sensors.fingerprint;
+
+import android.annotation.Nullable;
+import android.view.Display;
+
+import com.android.server.LocalServices;
+
+import java.io.PrintWriter;
+
+/**
+ * Optional device UDFPS lifecycle observer. Implementations must enqueue work and must not
+ * perform binder transactions from these callbacks. No observer is installed by default.
+ * Authentication decisions and HAL session calls remain with the biometric framework.
+ */
+public abstract class UdfpsLifecycle {
+    private static volatile DisplayState sDefaultDisplayState;
+
+    @Nullable
+    public static UdfpsLifecycle get() {
+        return LocalServices.getService(UdfpsLifecycle.class);
+    }
+
+    public abstract void onOperationStarted(int sensorId, long requestId, int userId, int state);
+    public abstract void onOperationFinished(int sensorId, long requestId);
+    public abstract void onOverlayChanged(int sensorId, long requestId, boolean attached);
+    public abstract void onControllerUnavailable();
+    public abstract void onHalUnavailable(int sensorId);
+    public abstract void onLockoutChanged(int sensorId, int userId, int mode);
+    public abstract void onDisplayChanged(DisplayState state);
+    public abstract void dump(PrintWriter writer);
+
+    /** Desired display state and existence of the framework ColorFade surface, not HBM state. */
+    public static final class DisplayState {
+        public final int state;
+        public final boolean colorFade;
+
+        private DisplayState(int state, boolean colorFade) {
+            this.state = state;
+            this.colorFade = colorFade;
+        }
+    }
+
+    @Nullable
+    public static DisplayState getDefaultDisplayState() {
+        return sDefaultDisplayState;
+    }
+
+    /** Called on the display power thread; observers must never block that thread. */
+    public static void dispatchDisplayChanged(int displayId, int state, boolean colorFade) {
+        if (displayId != Display.DEFAULT_DISPLAY) return;
+        final DisplayState snapshot = new DisplayState(state, colorFade);
+        sDefaultDisplayState = snapshot;
+        final UdfpsLifecycle observer = get();
+        if (observer != null) observer.onDisplayChanged(snapshot);
+    }
+}
