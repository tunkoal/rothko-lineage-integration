-        // The stock Goodix HAL asks for the FOD UI to be marked ready with vendor
-        // code 22. SystemUI only sends that signal while the display is on, so a
-        // screen-off touch otherwise ends in GF_ERROR_UI_READY_TIMEOUT.
-        if (acquiredInfo == FINGERPRINT_ACQUIRED_VENDOR && vendorCode == 22) {
