     bool isHdrClientComposition = false;
     ui::Dataspace bestDataSpace = getBestDataspace(&hdrDataSpace, &isHdrClientComposition);
 
+    DisplayColorPolicy devicePolicy;
+    if (physicalId) {
+        colorExtension.onContent(*physicalId, {.enabled = getState().isEnabled,
+                                               .managed = true,
+                                               .sdrCandidate = bestDataSpace,
+                                               .hdrCandidate = hdrDataSpace,
