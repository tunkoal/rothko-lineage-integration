diff --git a/services/surfaceflinger/CompositionEngine/include/compositionengine/DisplayColorExtension.h b/services/surfaceflinger/CompositionEngine/include/compositionengine/DisplayColorExtension.h
new file mode 100644
index 0000000000000000000000000000000000000000..e588f7da1633f28e9918f609f241bc5a38b10abc
--- /dev/null
+++ b/services/surfaceflinger/CompositionEngine/include/compositionengine/DisplayColorExtension.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <ui/DisplayId.h>
+#include <ui/GraphicTypes.h>
+#include <utils/Errors.h>
+
+namespace android::compositionengine {
+
+// Platform-private, compile-time device extension. This is not an OEM ABI or
+// an extension to ISurfaceComposer. The default implementation is inert.
+struct DisplayColorPolicy {
+    // Zero means no device policy. Nonzero revisions increase throughout the
+    // SF lifetime, including backend reconnect. A new revision permits one new
+    // HWC attempt even when its mode/intent equals an earlier failed selection.
+    uint64_t revision = 0;
+    std::optional<ui::RenderIntent> renderIntent;
+    bool wideColorGamut = true;
+};
+
+struct DisplayColorContent {
+    bool enabled = false;
+    bool managed = false;
+    ui::Dataspace sdrCandidate = ui::Dataspace::UNKNOWN;
+    ui::Dataspace hdrCandidate = ui::Dataspace::UNKNOWN;
+    // Existing getBestDataspace policy input, not a post-validate result.
+    bool forceHdrClientComposition = false;
+};
+
+enum class DisplayColorPowerMode { Unknown, Off, On, Doze, DozeSuspend };
+
+class DisplayColorExtension {
+public:
+    virtual ~DisplayColorExtension() = default;
+    virtual bool isEnabled() const { return false; }
+
+    // All methods may run under SF/composition locks. Implementations must
+    // only read cached policy or enqueue/coalesce bounded local state. No
+    // Binder/vendor IPC, disk access, waits, or calling invalidate inline.
+    virtual void setInvalidateCallback(std::function<void()> /*invalidate*/) {}
+    virtual void onDisplayConnected(PhysicalDisplayId, bool /*internal*/) {}
+    virtual void onDisplayDisconnected(PhysicalDisplayId) {}
+    virtual DisplayColorPolicy getPolicy(PhysicalDisplayId) const { return {}; }
+    virtual void onContent(PhysicalDisplayId, const DisplayColorContent&) {}
+    virtual void onPolicyRejected(PhysicalDisplayId, uint64_t /*revision*/) {}
+    virtual void onColorProfile(PhysicalDisplayId, uint64_t /*revision*/, ui::ColorMode,
+                                ui::Dataspace, ui::RenderIntent, status_t /*hwcResult*/) {}
+    // accepted describes the last actual HWC call, including an ON fallback.
+    // It is neither SF's requested-state cache nor a panel acknowledgement.
+    virtual void onPowerMode(PhysicalDisplayId, DisplayColorPowerMode /*requested*/,
+                             DisplayColorPowerMode /*lastAttempted*/, bool /*accepted*/) {}
+};
+
+// Device providers must isolate virtual/external displays, retain the latest
+// physical state for reconnect, and invoke invalidate only from their worker.
+DisplayColorExtension& getDisplayColorExtension();
+
+} // namespace android::compositionengine
