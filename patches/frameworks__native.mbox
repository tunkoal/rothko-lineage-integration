+struct OutputUpdateColorProfileTest_CachedSdrPolicy : OutputUpdateColorProfileTest {
+    struct CachedPolicy : DisplayColorExtension {
+        bool isEnabled() const override { return true; }
+        DisplayColorPolicy getPolicy(PhysicalDisplayId) const override {
+            return {.revision = 42,
+                    .renderIntent = static_cast<ui::RenderIntent>(257),
+                    .wideColorGamut = false};
+        }
+        void onContent(PhysicalDisplayId, const DisplayColorContent& content) override {
+            observed = content;
+            // Deliberately leave the cached SDR policy intact, as happens
+            // before the asynchronous device worker processes this HDR frame.
+        }
+        void onPolicyRejected(PhysicalDisplayId, uint64_t) override { ++rejected; }
+        DisplayColorContent observed;
+        int rejected = 0;
+    } extension;
+
+    OutputUpdateColorProfileTest_CachedSdrPolicy() {
+        mOutput.colorExtensionForTest = &extension;
+        mRefreshArgs.outputColorSetting = OutputColorSetting::kManaged;
+        EXPECT_CALL(mOutput, getOutputLayerCount()).WillRepeatedly(Return(1u));
+        EXPECT_CALL(*mDisplayColorProfile,
+                    getBestColorMode(_, static_cast<ui::RenderIntent>(257), _, _, _)).Times(0);
+    }
+
+    void verifyHdrFrame(ui::Dataspace hdr, bool legacy, bool client) {
+        mLayer1.mLayerFEState.dataspace = hdr;
+        mLayer1.mLayerFEState.forceClientComposition = client;
+        EXPECT_CALL(*mDisplayColorProfile, hasLegacyHdrSupport(hdr)).WillOnce(Return(legacy));
+        const bool nativeHdr = !legacy && !client;
+        const auto dataspace = nativeHdr ? hdr : ui::Dataspace::V0_SRGB;
+        const auto intent = nativeHdr ? ui::RenderIntent::TONE_MAP_COLORIMETRIC
+                                      : ui::RenderIntent::COLORIMETRIC;
+        const auto mode = nativeHdr ? (hdr == ui::Dataspace::BT2020_HLG
+                                               ? ui::ColorMode::BT2100_HLG
+                                               : ui::ColorMode::BT2100_PQ)
+                                    : ui::ColorMode::SRGB;
+        EXPECT_CALL(*mDisplayColorProfile, getBestColorMode(dataspace, intent, _, _, _))
+                .WillOnce(DoAll(SetArgPointee<2>(dataspace), SetArgPointee<3>(mode),
+                                SetArgPointee<4>(intent)));
+        EXPECT_CALL(mOutput, setColorProfile(ColorProfileEq(ColorProfile{mode, dataspace, intent})));
+        mOutput.updateColorProfile(mRefreshArgs);
+        EXPECT_EQ(hdr, extension.observed.hdrCandidate);
+        EXPECT_EQ(dataspace, extension.observed.outputCandidate);
+        EXPECT_EQ(0, extension.rejected);
+    }
+};
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstPqFramePreservesNativeToneMapping) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, false, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstHlgFramePreservesNativeToneMapping) {
+    verifyHdrFrame(ui::Dataspace::BT2020_HLG, false, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstLegacyHdrFramePreservesUpstreamPolicy) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, true, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstClientHdrFramePreservesUpstreamPolicy) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, false, true);
+}
