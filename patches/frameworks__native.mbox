+        // Preserve the existing HDR selection. WCG only adjusts its SDR
+        // candidate when HDR is present; it is not a global color-management
+        // switch and does not classify layers a second time.
+        if (devicePolicy.revision != 0 && !devicePolicy.wideColorGamut &&
+            hdrDataSpace != ui::Dataspace::UNKNOWN) {
+            bestDataSpace = ui::Dataspace::V0_SRGB;
+        }
+    }
+
     switch (refreshArgs.forceOutputColorMode) {
         case ui::ColorMode::SRGB:
             bestDataSpace = ui::Dataspace::V0_SRGB;
@@ -1142,6 +1167,21 @@ compositionengine::Output::ColorProfile Output::pickColorProfile(
     mDisplayColorProfile->getBestColorMode(bestDataSpace, intent, &outDataSpace, &outMode,
                                            &outRenderIntent);
 
+    if (devicePolicy.revision != 0 && devicePolicy.renderIntent) {
+        ui::ColorMode deviceMode;
+        ui::Dataspace deviceDataSpace;
+        ui::RenderIntent deviceIntent;
+        mDisplayColorProfile->getBestColorMode(bestDataSpace, *devicePolicy.renderIntent,
+                                              &deviceDataSpace, &deviceMode, &deviceIntent);
+        // Do not accept getBestColorMode's UNKNOWN/NATIVE fallback as a
+        // successful application of an unsupported vendor intent.
+        if (deviceDataSpace != ui::Dataspace::UNKNOWN &&
+            deviceIntent == *devicePolicy.renderIntent) {
+            return ColorProfile{deviceMode, deviceDataSpace, deviceIntent, devicePolicy.revision};
+        }
+        colorExtension.onPolicyRejected(*physicalId, devicePolicy.revision);
+    }
+
     return ColorProfile{outMode, outDataSpace, outRenderIntent};
 }
 
