From 6017a9d7df490324c45753b68e7ac116c69843e4 Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Tue, 6 Oct 2026 17:57:40 +0800
Subject: [PATCH 1/4] libgui: set BLAST dequeue count after releasing
 initialization lock

Expanded frame histories synchronously call resizeFrameEventHistory from the producer setter. initialize already holds the same nonrecursive mutex, leaving bootanimation and window creation blocked before their first frame. Move the existing default setter into onFirstRef after initialize returns, preserving the count and callback locking.

Observed on rothko in two timed captures: bootanimation, Settings, SystemUI and ImageWallpaper share this self-lock stack. Build and post-fix device validation are pending.

Change-Id: I35eec22fe78cf63c38a123fb46e77b5094b17ca8
---
 libs/gui/BLASTBufferQueue.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libs/gui/BLASTBufferQueue.cpp b/libs/gui/BLASTBufferQueue.cpp
index 05fbc148d2c99287b4914a7fea2025491fdbb303..bfcf136e8f3ea7544efe6a9549f4ad29c6b537af 100644
--- a/libs/gui/BLASTBufferQueue.cpp
+++ b/libs/gui/BLASTBufferQueue.cpp
@@ -223,9 +223,6 @@ void BLASTBufferQueue::initialize() {
             },
             this);
 
-    // safe default, most producers are expected to override this
-    mProducer->setMaxDequeuedBufferCount(2);
-
     BQA_LOGV("BLASTBufferQueue created");
 }
 
@@ -261,6 +258,9 @@ BLASTBufferQueue::~BLASTBufferQueue() {
 
 void BLASTBufferQueue::onFirstRef() {
     initialize();
+    // This can resize frame history and re-enter mMutex; initialize must return first.
+    // Safe default, most producers are expected to override this.
+    mProducer->setMaxDequeuedBufferCount(2);
 }
 
 void BLASTBufferQueue::update(const sp<SurfaceControl>& surface, uint32_t width, uint32_t height,

