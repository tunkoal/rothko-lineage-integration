                 return ServiceManager.waitForDeclaredService(
@@ -571,19 +581,57 @@ public final class LineageHardwareManager {
         return false;
     }
 
+    private IDisplayModes getDisplayModesService() {
+        synchronized (mDisplayModesLock) {
+            IBinder binder = mAIDLMap.get(FEATURE_DISPLAY_MODES);
+            if (binder != null && binder.isBinderAlive()) {
+                return IDisplayModes.Stub.asInterface(binder);
+            }
+            if (binder != null) {
+                invalidateDisplayModesService(binder);
+            }
+
+            // Do not wait indefinitely for a declared but stopped HAL, or cache absence.
+            final IBinder service = getAIDLService(FEATURE_DISPLAY_MODES);
+            if (service == null) {
+                return null;
+            }
+            final IBinder.DeathRecipient recipient =
+                    () -> invalidateDisplayModesService(service);
+            try {
+                service.linkToDeath(recipient, 0);
+            } catch (RemoteException e) {
+                return null;
+            }
+            mDisplayModesDeathRecipient = recipient;
+            mAIDLMap.put(FEATURE_DISPLAY_MODES, service);
+            return IDisplayModes.Stub.asInterface(service);
+        }
+    }
+
+    private void invalidateDisplayModesService(IBinder service) {
+        synchronized (mDisplayModesLock) {
+            // A late death/error from an old service must not evict its replacement.
+            if (mAIDLMap.get(FEATURE_DISPLAY_MODES) == service) {
+                mAIDLMap.remove(FEATURE_DISPLAY_MODES);
+                if (mDisplayModesDeathRecipient != null) {
+                    service.unlinkToDeath(mDisplayModesDeathRecipient, 0);
+                    mDisplayModesDeathRecipient = null;
+                }
+            }
+        }
+    }
