From 7fdff62d4761ec31565a03b81900858664082e88 Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Sat, 24 Oct 2026 22:09:03 +0800
Subject: [PATCH 2/4] health: Apply charging limit when the previous value is
 unknown

The HAL contract permits EX_ILLEGAL_STATE when it cannot determine the driver limit. Treat that specific read failure as unknown and attempt the requested write, while preserving transport, unsupported-operation and setter failures.

Validated with the production Limit and ChargingControlProvider classes in a host Java harness: nine checks covering initialization, updates, reset and errors. No ROM build or device writes.

Change-Id: I027887076def7247f84314da50fb457a31a00d11
---
 .../internal/health/ccprovider/Limit.java     | 23 ++++++++++++-------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/health/ccprovider/Limit.java b/lineage/lib/main/java/org/lineageos/platform/internal/health/ccprovider/Limit.java
index fdc98a49b84ea77a5bcbc5a8c99b72dbe84ef0d9..90a8fbf315f4f69c2c67c1f5cb0cfce092e00c9e 100644
--- a/lineage/lib/main/java/org/lineageos/platform/internal/health/ccprovider/Limit.java
+++ b/lineage/lib/main/java/org/lineageos/platform/internal/health/ccprovider/Limit.java
@@ -59,16 +59,23 @@ public class Limit extends ChargingControlProvider {
 
     private boolean setChargingLimit(int targetPct) {
         try {
-            if (mChargingControl.getChargingLimit().max != targetPct) {
-                ChargingLimitInfo limit = new ChargingLimitInfo();
-                if (targetPct == 100) {
-                    limit.min = 0;
-                } else {
-                    limit.min = targetPct - mChargingLimitMargin;
+            try {
+                if (mChargingControl.getChargingLimit().max == targetPct) {
+                    return true;
                 }
-                limit.max = targetPct;
-                mChargingControl.setChargingLimit(limit);
+            } catch (IllegalStateException e) {
+                // The HAL may be unable to determine the previous driver limit.
+                // This does not prevent applying the requested limit.
+                Log.i(TAG, "Current charging limit is unknown, applying target: " + targetPct);
             }
+            ChargingLimitInfo limit = new ChargingLimitInfo();
+            if (targetPct == 100) {
+                limit.min = 0;
+            } else {
+                limit.min = targetPct - mChargingLimitMargin;
+            }
+            limit.max = targetPct;
+            mChargingControl.setChargingLimit(limit);
             return true;
         } catch (Exception e) {
             Log.e(TAG, "Failed to set charging limit", e);

