 .../hardware/LineageHardwareManager.java      | 136 +++++++++++++-----
 2 files changed, 112 insertions(+), 33 deletions(-)

diff --git a/sdk/src/java/lineageos/hardware/AIDLHelper.java b/sdk/src/java/lineageos/hardware/AIDLHelper.java
index 0a47311a210b3df98b9e127e69b051653a5a2af0..73f9d79def02e35de7532ce8dae005ab30e0b896 100644
--- a/sdk/src/java/lineageos/hardware/AIDLHelper.java
+++ b/sdk/src/java/lineageos/hardware/AIDLHelper.java
@@ -11,16 +11,25 @@ import java.util.ArrayList;
 
 class AIDLHelper {
     static DisplayMode[] fromAIDLModes(vendor.lineage.livedisplay.DisplayMode[] modes) {
+        if (modes == null) {
+            return null;
+        }
         int size = modes.length;
         DisplayMode[] r = new DisplayMode[size];
         for (int i = 0; i < size; i++) {
             vendor.lineage.livedisplay.DisplayMode m = modes[i];
+            if (m == null || m.name == null) {
+                return null;
+            }
             r[i] = new DisplayMode(m.id, m.name);
         }
         return r;
     }
 
     static DisplayMode fromAIDLMode(vendor.lineage.livedisplay.DisplayMode mode) {
+        if (mode == null || mode.name == null) {
+            return null;
+        }
         return new DisplayMode(mode.id, mode.name);
     }
 
