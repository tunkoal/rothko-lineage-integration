+    /**
+     * TextureView already maps the whole buffer onto the view. Correct that nonuniform mapping
+     * around the center so source pixels have equal X/Y scale, then apply the HAL placement.
+     * Buffer orientation/mirroring belongs to the HAL camera pipeline; do not rotate it twice.
+     */
+    static Matrix createHalPreviewTransform(int viewWidth, int viewHeight,
+            FaceSensorPropertiesInternal properties) {
+        final float fill = Math.max((float) viewWidth / properties.enrollPreviewWidth,
+                (float) viewHeight / properties.enrollPreviewHeight);
+        final float scaleX = properties.enrollPreviewWidth * fill / viewWidth;
+        final float scaleY = properties.enrollPreviewHeight * fill / viewHeight;
+        final Matrix transform = new Matrix();
+        transform.setScale(scaleX * properties.enrollPreviewScale,
+                scaleY * properties.enrollPreviewScale, viewWidth / 2f, viewHeight / 2f);
+        transform.postTranslate(properties.enrollTranslationX, properties.enrollTranslationY);
+        return transform;
+    }
