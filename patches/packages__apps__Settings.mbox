 1 file changed, 14 insertions(+)

diff --git a/src/com/android/settings/biometrics/face/FaceFeatureProviderImpl.java b/src/com/android/settings/biometrics/face/FaceFeatureProviderImpl.java
index d93b8b0963536f22356250350f33e62b5777a3db..f66e451dcb9c89b4df2536d1e9054016d76f1d33 100644
--- a/src/com/android/settings/biometrics/face/FaceFeatureProviderImpl.java
+++ b/src/com/android/settings/biometrics/face/FaceFeatureProviderImpl.java
@@ -91,6 +91,20 @@ public class FaceFeatureProviderImpl implements FaceFeatureProvider {
 
     @Override
     public int getMaxEnrollableCount(@NonNull Context context) {
+        if (mMaxEnrollableCount == -1) {
+            // The registered callback is delivered asynchronously, so the first
+            // query of the enrollment flow can arrive before it. Fall back to
+            // the synchronous cache the framework already holds.
+            final FaceManager faceManager = Utils.getFaceManagerOrNull(context);
+            if (faceManager != null) {
+                final List<FaceSensorPropertiesInternal> sensors =
+                        faceManager.getSensorPropertiesInternal();
+                if (sensors != null && !sensors.isEmpty()) {
+                    mMaxEnrollableCount = sensors.get(0).maxEnrollmentsPerUser;
+                    Log.d(TAG, "max enrollable count from cache: " + mMaxEnrollableCount);
+                }
+            }
+        }
         if (mMaxEnrollableCount == -1) {
             Log.e(TAG, "The max enrollable count is not yet initialized.");
             return 0;

