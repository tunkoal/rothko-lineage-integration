+@RunWith(RobolectricTestRunner.class)
+public class FaceEnrollSidecarTest {
+    private final FaceUpdater mUpdater = mock(FaceUpdater.class);
+    private final Surface mSurface = mock(Surface.class);
+    private final SurfaceTexture mTexture = mock(SurfaceTexture.class);
+    private final Intent mIntent = new Intent();
+
+    private FaceEnrollSidecar startSidecar(boolean halControlsPreview) {
+        final ActivityController<FragmentActivity> controller =
+                Robolectric.buildActivity(FragmentActivity.class).create();
+        final FaceEnrollSidecar sidecar =
+                new FaceEnrollSidecar(new int[0], mIntent, halControlsPreview);
+        controller.get().getSupportFragmentManager().beginTransaction()
+                .add(sidecar, "face_sidecar").commitNow();
+        ReflectionHelpers.setField(sidecar, "mFaceUpdater", mUpdater);
+        controller.start().resume();
+        when(mSurface.isValid()).thenReturn(true);
+        return sidecar;
+    }
+
+    private FaceManager.EnrollmentCallback captureCallback(Surface surface) {
+        final ArgumentCaptor<FaceManager.EnrollmentCallback> callback =
+                ArgumentCaptor.forClass(FaceManager.EnrollmentCallback.class);
+        verify(mUpdater).enroll(anyInt(), nullable(byte[].class), any(CancellationSignal.class),
+                callback.capture(), any(int[].class), eq(surface), eq(false), same(mIntent));
+        return callback.getValue();
+    }
+
+    @Test
+    public void halPreview_waitsForSurfaceAndStartsOnlyOnce() {
+        final FaceEnrollSidecar sidecar = startSidecar(true);
+        verifyNoInteractions(mUpdater);
+        final FaceEnrollSidecar.PreviewSurface preview =
+                new FaceEnrollSidecar.PreviewSurface(mTexture, mSurface);
+        sidecar.setPreviewSurface(preview);
+        final FaceManager.EnrollmentCallback callback = captureCallback(mSurface);
+        sidecar.setPreviewSurface(preview);
+        sidecar.startEnrollment();
+        verify(mSurface, never()).release();
+        verify(mUpdater, times(1)).enroll(anyInt(), nullable(byte[].class),
+                any(CancellationSignal.class), any(FaceManager.EnrollmentCallback.class),
+                any(int[].class), same(mSurface), eq(false), same(mIntent));
+        callback.onEnrollmentError(FACE_ERROR_CANCELED, "Canceled");
+    }
+
+    @Test
+    public void cancellation_keepsDetachedProducerUntilTerminalCallback() {
+        final FaceEnrollSidecar sidecar = startSidecar(true);
+        final FaceEnrollSidecar.PreviewSurface preview =
+                new FaceEnrollSidecar.PreviewSurface(mTexture, mSurface);
+        sidecar.setPreviewSurface(preview);
+        final FaceManager.EnrollmentCallback callback = captureCallback(mSurface);
+        sidecar.cancelEnrollment();
+        preview.detachTexture();
+        verify(mSurface, never()).release();
+        verify(mTexture, never()).release();
+        callback.onEnrollmentError(FACE_ERROR_CANCELED, "Canceled");
+        callback.onEnrollmentError(FACE_ERROR_CANCELED, "Late duplicate");
+        verify(mSurface, times(1)).release();
+        verify(mTexture, times(1)).release();
+    }
+
+    @Test
+    public void completedGeneration_ignoresLateHelpAndDoesNotRestart() {
+        final FaceEnrollSidecar sidecar = startSidecar(true);
+        final BiometricEnrollSidecar.Listener listener = mock(BiometricEnrollSidecar.Listener.class);
+        sidecar.setListener(listener);
+        sidecar.setPreviewSurface(new FaceEnrollSidecar.PreviewSurface(mTexture, mSurface));
+        final FaceManager.EnrollmentCallback callback = captureCallback(mSurface);
+        callback.onEnrollmentProgress(0);
+        callback.onEnrollmentHelp(1, "Late help");
+        sidecar.startEnrollment();
+        verify(listener).onEnrollmentProgressChange(0, 0);
+        verify(listener, never()).onEnrollmentHelp(anyInt(), any());
+        verify(mUpdater, times(1)).enroll(anyInt(), nullable(byte[].class),
+                any(CancellationSignal.class), any(FaceManager.EnrollmentCallback.class),
+                any(int[].class), same(mSurface), eq(false), same(mIntent));
+        verify(mSurface).release();
+        verify(mTexture, never()).release();
+    }
+
+    @Test
+    public void replacementSurface_releasesOnlyRejectedGeneration() {
+        final FaceEnrollSidecar sidecar = startSidecar(true);
+        sidecar.setPreviewSurface(new FaceEnrollSidecar.PreviewSurface(mTexture, mSurface));
+        final FaceManager.EnrollmentCallback callback = captureCallback(mSurface);
+        final Surface replacement = mock(Surface.class);
+        final SurfaceTexture replacementTexture = mock(SurfaceTexture.class);
+        final FaceEnrollSidecar.PreviewSurface preview =
+                new FaceEnrollSidecar.PreviewSurface(replacementTexture, replacement);
+        sidecar.setPreviewSurface(preview);
+        verify(replacement).release();
+        verify(mSurface, never()).release();
+        preview.detachTexture();
+        verify(replacementTexture).release();
+        callback.onEnrollmentError(FACE_ERROR_CANCELED, "Canceled");
+    }
+
+    @Test
+    public void legacyPreview_enrollsWithNullSurface() {
+        startSidecar(false);
+        captureCallback(null).onEnrollmentError(FACE_ERROR_CANCELED, "Canceled");
+    }
+}

