+import org.robolectric.RobolectricTestRunner;
+
+import java.util.Collections;
+
+@RunWith(RobolectricTestRunner.class)
+public class FaceEnrollPreviewFragmentTest {
+    @Test
+    public void halTransform_preservesSourceAspectAndCentersPlacement() {
+        final FaceSensorPropertiesInternal properties = new FaceSensorPropertiesInternal(8,
+                SensorProperties.STRENGTH_CONVENIENCE, 2, Collections.emptyList(),
+                FaceSensorProperties.TYPE_RGB, false, true, false,
+                true, 0, 480, 640, 100f, 50f, 1f);
+        final Matrix transform = FaceEnrollPreviewFragment.createHalPreviewTransform(
+                300, 300, properties);
+        final float[] values = new float[9];
+        transform.getValues(values);
+        // Compose with TextureView's implicit buffer-to-view mapping: each source pixel must
+        // have the same physical scale on both axes, including for a nonsquare HAL buffer.
+        assertThat(values[Matrix.MSCALE_X] * 300f / 480f)
+                .isWithin(0.0001f).of(values[Matrix.MSCALE_Y] * 300f / 640f);
+        final float[] center = {150f, 150f};
+        transform.mapPoints(center);
+        assertThat(center[0]).isWithin(0.0001f).of(250f);
+        assertThat(center[1]).isWithin(0.0001f).of(200f);
+    }
+}
