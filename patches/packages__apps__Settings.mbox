+    private void startPreview(SurfaceTexture texture, int width, int height) {
+        if (!mPreviewConfigured || !mResumed) {
+            return;
+        }
+        if (!halControlsPreview()) {
+            openCamera(width, height);
+            return;
+        }
+        if (mPreviewStopped || mHalPreview != null) {
+            return;
+        }
+        final FaceSensorPropertiesInternal properties = mSensorProperties;
+        if (texture == null || properties.enrollPreviewWidth <= 0
+                || properties.enrollPreviewHeight <= 0
+                || !Float.isFinite(properties.enrollPreviewScale)
+                || properties.enrollPreviewScale <= 0f
+                || !Float.isFinite(properties.enrollTranslationX)
+                || !Float.isFinite(properties.enrollTranslationY)
+                || getActivity().getDisplay() == null
+                || getActivity().getDisplay().getDisplayId() != properties.previewDisplayId) {
+            // Falling back to a second CameraDevice would compete with this HAL's camera.
+            mPreviewStopped = true;
+            mPreviewSurfaceListener.onPreviewError();
+            return;
+        }
+        mPreviewSize = new Size(properties.enrollPreviewWidth, properties.enrollPreviewHeight);
+        texture.setDefaultBufferSize(mPreviewSize.getWidth(), mPreviewSize.getHeight());
+        configureTransform(width, height);
+        mHalPreview = new FaceEnrollSidecar.PreviewSurface(texture);
+        mPreviewSurfaceListener.onPreviewSurfaceReady(mHalPreview);
+    }
+
+    private void stopHalPreview() {
+        if (!mPreviewStopped) {
+            mPreviewStopped = true;
+            if (mPreviewSurfaceListener != null) {
+                mPreviewSurfaceListener.onPreviewStopped();
+            }
+        }
+    }
