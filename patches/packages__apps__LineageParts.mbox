@@ -308,7 +308,13 @@ public class ColorProfileFragment extends SettingsPreferenceFragment implements
 
     private void showStatus(int title, boolean retry) {
         mStatusPreference.setTitle(title);
-        mStatusPreference.setSummary(retry ? R.string.live_display_color_profile_retry : 0);
+        // An int summary is a string resource id, so the non-retry state must
+        // clear the summary instead of passing 0, which crashes the page.
