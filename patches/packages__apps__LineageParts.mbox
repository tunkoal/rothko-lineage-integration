     <string name="sms_security_check_limit_always_confirm">Always confirm</string>
+    <!-- Color profile service availability and confirmed mode changes. -->
+    <string name="live_display_color_profile_loading">Loading color profiles…</string>
+    <string name="live_display_color_profile_unavailable">Color profiles unavailable</string>
+    <string name="live_display_color_profile_retry">Tap to try again</string>
