 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/org/lineageos/lineageparts/livedisplay/ColorProfileFragment.java b/src/org/lineageos/lineageparts/livedisplay/ColorProfileFragment.java
index 88028bc23cca4ae2f26d094b0cba73881745a5bc..1056506aa90c7ff136439d42ea5a603dbda794b1 100644
