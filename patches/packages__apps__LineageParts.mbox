-    private SelectorWithWidgetPreference bindPreference(SelectorWithWidgetPreference pref, DisplayMode mode) {
-        final DisplayMode defaultMode = mHardware.getCurrentDisplayMode() != null
-                    ? mHardware.getCurrentDisplayMode() : mHardware.getDefaultDisplayMode();
+    private void loadDisplayModes() {
+        if (mStarted) {
+            requestDisplayModes(null);
+        }
+    }
+
+    private void requestDisplayModes(DisplayMode requestedMode) {
+        final int generation = ++mRequestGeneration;
+        setBusy(true);
+        showStatus(R.string.live_display_color_profile_loading, false);
+        mDisplayModeExecutor.execute(() -> {
+            boolean applied = false;
+            DisplayModeState state = null;
+            try {
+                if (requestedMode != null) {
+                    applied = mHardware.setDisplayMode(requestedMode, true);
+                }
+                // Read back even on failure: active may have changed before saving failed.
+                state = new DisplayModeState(mHardware.getDisplayModes(),
+                        mHardware.getCurrentDisplayMode(), mHardware.getDefaultDisplayMode());
+            } catch (RuntimeException e) {
+                Log.w("LiveDisplay", "Unable to update color profiles", e);
+            }
+            final DisplayModeState result = state;
+            final boolean success = applied;
+            mHandler.post(() -> {
+                if (!mStarted || generation != mRequestGeneration
+                        || mPreviewPreference == null || !isAdded()) {
+                    return;
+                }
+                updateDisplayModes(result);
+                setBusy(false);
+                if (requestedMode != null && (!success || result == null
+                        || !result.confirms(requestedMode.id))) {
+                    Toast.makeText(requireContext(),
+                            R.string.live_display_color_profile_change_failed,
+                            Toast.LENGTH_LONG).show();
+                }
+            });
+        });
+    }
+
+    private void bindPreference(SelectorWithWidgetPreference pref, DisplayMode mode,
+            DisplayMode selectedMode) {
         pref.setTitle(ResourceUtils.getLocalizedString(
                     getResources(), mode.name, COLOR_PROFILE_TITLE));
         pref.setKey(COLOR_PROFILE + mode.id);
-        if (mode.id == defaultMode.id) {
-            pref.setChecked(true);
-        }
+        pref.setChecked(selectedMode != null && mode.id == selectedMode.id);
         pref.setOnClickListener(this);
-        return pref;
     }
 
-    private void updateCheckedState(String selectedKey) {
+    private void updateDisplayModes(DisplayModeState state) {
         final PreferenceScreen screen = getPreferenceScreen();
-        if (screen != null) {
-            final int count = screen.getPreferenceCount();
-            for (int i = 0; i < count; i++) {
-                final Preference pref = screen.getPreference(i);
-                if (pref instanceof SelectorWithWidgetPreference) {
-                    final SelectorWithWidgetPreference radioPref = (SelectorWithWidgetPreference) pref;
-                    final boolean newCheckedState = TextUtils.equals(pref.getKey(), selectedKey);
-                    if (radioPref.isChecked() != newCheckedState) {
-                        radioPref.setChecked(TextUtils.equals(pref.getKey(), selectedKey));
-                    }
-                }
-            }
+        mStateAvailable = state != null && state.isAvailable();
+        if (!mStateAvailable) {
+            // Keep the last known selection, disabled, until the service can be read again.
+            showStatus(R.string.live_display_color_profile_unavailable, true);
+            return;
+        }
+        mDisplayModes = state.modes;
+        screen.removeAll();
+        screen.addPreference(mPreviewPreference);
+        for (DisplayMode mode : mDisplayModes) {
+            final SelectorWithWidgetPreference pref =
+                    new SelectorWithWidgetPreference(screen.getContext());
+            bindPreference(pref, mode, state.selectedMode());
+            screen.addPreference(pref);
         }
     }
 
-    private void mayCheckOnlyRadioButton() {
+    private void showStatus(int title, boolean retry) {
+        mStatusPreference.setTitle(title);
+        mStatusPreference.setSummary(retry ? R.string.live_display_color_profile_retry : 0);
+        mStatusPreference.setSelectable(retry);
+        mStatusPreference.setEnabled(retry);
+        getPreferenceScreen().addPreference(mStatusPreference);
+    }
+
+    private void setBusy(boolean busy) {
+        mBusy = busy;
         final PreferenceScreen screen = getPreferenceScreen();
-        // If there is only 1 thing on screen, select it.
-        if (screen != null && screen.getPreferenceCount() == 1) {
-            final Preference onlyPref = screen.getPreference(0);
-            if (onlyPref instanceof SelectorWithWidgetPreference) {
-                ((SelectorWithWidgetPreference) onlyPref).setChecked(true);
+        for (int i = 0; i < screen.getPreferenceCount(); i++) {
+            final Preference pref = screen.getPreference(i);
+            if (pref instanceof SelectorWithWidgetPreference) {
+                pref.setEnabled(!busy && mStateAvailable);
+            }
+        }
+    }
+
+    private static class DisplayModeState {
+        final DisplayMode[] modes;
+        final DisplayMode currentMode;
+        final DisplayMode defaultMode;
+
+        DisplayModeState(DisplayMode[] modes, DisplayMode currentMode, DisplayMode defaultMode) {
+            this.modes = modes;
+            this.currentMode = currentMode;
+            this.defaultMode = defaultMode;
+        }
+
+        DisplayMode selectedMode() {
+            // The saved boot default does not prove which mode is active now.
+            return currentMode;
+        }
+
+        boolean isAvailable() {
+            final DisplayMode selected = selectedMode();
+            if (modes != null && selected != null) {
+                for (DisplayMode mode : modes) {
+                    if (mode.id == selected.id) {
+                        return true;
+                    }
+                }
             }
+            return false;
+        }
+
+        boolean confirms(int id) {
+            return isAvailable() && currentMode != null && currentMode.id == id
+                    && defaultMode != null && defaultMode.id == id;
         }
     }
 

