Subject: [PATCH 2/2] Allow optional Soong runtime memory limit

Pass SOONG_GOMEMLIMIT through the hermetic primary builder environment as GOMEMLIMIT. With no setting, upstream behavior stays unchanged. Adapt only the memory-limit portion of SherlockChiang/aviumui-apollon-overlay patches/0003-soong-memory-limits.patch; no GOGC passthrough or Blueprint changes.

Change-Id: Id940ada331f4f9b818c20373a0170a17a946d6e3
---
 ui/build/soong.go | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/ui/build/soong.go b/ui/build/soong.go
index c9b303c5bf7c217ebe362c788810a4e031e26333..e7e3ce497744d8e35935165f14887296b9e083cd 100644
--- a/ui/build/soong.go
+++ b/ui/build/soong.go
@@ -226,6 +226,9 @@ func (pb PrimaryBuilderFactory) primaryBuilderInvocation(config Config) bootstra
 
 	commonArgs = append(commonArgs, "-l", filepath.Join(pb.config.FileListDir(), "Android.bp.list"))
 	invocationEnv := make(map[string]string)
+	if goMemLimit := os.Getenv("SOONG_GOMEMLIMIT"); goMemLimit != "" {
+		invocationEnv["GOMEMLIMIT"] = goMemLimit
+	}
 	if pb.debugPort != "" {
 		//debug mode
 		commonArgs = append(commonArgs, "--delve_listen", pb.debugPort,
