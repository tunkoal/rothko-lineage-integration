+namespace android::camera3::JpegRCompositeUtils {
+
+// Empty by default. Only explicitly selected provider IDs may replace native JPEG_R.
+inline constexpr char kCameraIdsProperty[] = "ro.camera.compositeJpegRIds";
+bool containsCameraId(std::string_view cameraIds, std::string_view cameraId);
+bool isEnabled(const std::string& cameraId);
+
+bool supportsConcurrentJpeg(const CameraMetadata& info, int64_t profile);
+bool supportsJpegColorSpace(const CameraMetadata& info, int32_t colorSpace);
+
+// Replace native JPEG_R metadata atomically, using only real P010/JPEG capabilities.
+// Requires API3 (P010 + HAL JPEG); never enables the API0 reference fallback.
+status_t deriveCharacteristics(CameraMetadata* info);
+
+// The range comes from the acquired buffer, not the requested stream dataspace.
+// Unknown/extended ranges are rejected instead of being guessed.
+status_t getP010FullRange(android_dataspace dataSpace, bool* fullRange);
+
+} // namespace android::camera3::JpegRCompositeUtils
