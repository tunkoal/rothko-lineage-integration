new file mode 100644
index 0000000000000000000000000000000000000000..b9e182bc8a65375f342c95d6b5da25e4a48d42fb
--- /dev/null
+++ b/services/camera/libcameraservice/utils/JpegRCompositeUtils.cpp
@@ -0,0 +1,221 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "JpegRCompositeUtils.h"
+
+#include <algorithm>
+#include <android-base/properties.h>
+#include <array>
+#include <map>
+#include <set>
+#include <ui/PublicFormat.h>
+#include <vector>
+
+namespace android::camera3::JpegRCompositeUtils {
+namespace {
+constexpr int64_t kStandard = ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP_STANDARD;
+constexpr int64_t kHlg = ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP_HLG10;
+constexpr std::array<uint32_t, 6> kJpegRTags = {
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS,
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_MIN_FRAME_DURATIONS,
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_STALL_DURATIONS,
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION,
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_MIN_FRAME_DURATIONS_MAXIMUM_RESOLUTION,
+        ANDROID_JPEGR_AVAILABLE_JPEG_R_STALL_DURATIONS_MAXIMUM_RESOLUTION};
+using Size = std::pair<int32_t, int32_t>;
+
+status_t deriveMode(CameraMetadata* info, bool maximumResolution, std::vector<int32_t>* keys) {
+    const uint32_t configTag = maximumResolution
+            ? ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION
+            : ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS;
+    const uint32_t minTag = maximumResolution
+            ? ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS_MAXIMUM_RESOLUTION
+            : ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS;
+    const uint32_t stallTag = maximumResolution
+            ? ANDROID_SCALER_AVAILABLE_STALL_DURATIONS_MAXIMUM_RESOLUTION
+            : ANDROID_SCALER_AVAILABLE_STALL_DURATIONS;
+    const CameraMetadata& metadata = *info;
+    auto configs = metadata.find(configTag);
+    auto minimums = metadata.find(minTag);
+    auto stalls = metadata.find(stallTag);
+    if (configs.count % 4 || minimums.count % 4 || stalls.count % 4) return BAD_VALUE;
+    if (configs.count == 0) return maximumResolution ? OK : BAD_VALUE;
+
+    std::set<Size> jpegSizes, p010Sizes;
+    for (size_t i = 0; i < configs.count; i += 4) {
+        if (configs.data.i32[i+3] != ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) {
+            continue;
+        }
+        Size size{configs.data.i32[i+1], configs.data.i32[i+2]};
+        if (size.first <= 0 || size.second <= 0) return BAD_VALUE;
+        if (configs.data.i32[i] == HAL_PIXEL_FORMAT_BLOB) jpegSizes.insert(size);
+        if (configs.data.i32[i] == HAL_PIXEL_FORMAT_YCBCR_P010) p010Sizes.insert(size);
+    }
+    auto durations = [](const camera_metadata_ro_entry_t& entry, int32_t format) {
+        std::map<Size, int64_t> result;
+        for (size_t i = 0; i < entry.count; i += 4) {
+            if (entry.data.i64[i] == format) {
+                result[{entry.data.i64[i+1], entry.data.i64[i+2]}] = entry.data.i64[i+3];
+            }
+        }
+        return result;
+    };
+    auto jpegMinimums = durations(minimums, HAL_PIXEL_FORMAT_BLOB);
+    auto p010Minimums = durations(minimums, HAL_PIXEL_FORMAT_YCBCR_P010);
+    auto jpegStalls = durations(stalls, HAL_PIXEL_FORMAT_BLOB);
+    std::vector<int32_t> streams;
+    std::vector<int64_t> minDurations, stallDurations;
+    for (const auto& size : p010Sizes) {
+        if (!jpegSizes.count(size)) continue;
+        // Do not advertise a size whose underlying stream timings are absent.
+        if (!jpegMinimums.count(size) || !p010Minimums.count(size) || !jpegStalls.count(size) ||
+                jpegMinimums.at(size) < 0 || p010Minimums.at(size) < 0 || jpegStalls.at(size) < 0) {
+            return BAD_VALUE;
+        }
+        streams.insert(streams.end(), {HAL_PIXEL_FORMAT_BLOB, size.first, size.second,
+                ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS_OUTPUT});
+        minDurations.insert(minDurations.end(), {HAL_PIXEL_FORMAT_BLOB, size.first, size.second,
+                std::max(jpegMinimums.at(size), p010Minimums.at(size))});
+        // As in the upstream composite route, JPEG stall is an approximation;
+        // software gain-map latency still needs device measurement.
+        stallDurations.insert(stallDurations.end(),
+                {HAL_PIXEL_FORMAT_BLOB, size.first, size.second, jpegStalls.at(size)});
+    }
+    if (streams.empty()) return maximumResolution ? OK : BAD_VALUE;
+    size_t offset = maximumResolution ? 3 : 0;
+    status_t res = info->update(kJpegRTags[offset], streams.data(), streams.size());
+    if (res != OK) return res;
+    res = info->update(kJpegRTags[offset+1], minDurations.data(), minDurations.size());
+    if (res != OK) return res;
+    res = info->update(kJpegRTags[offset+2], stallDurations.data(), stallDurations.size());
+    if (res != OK) return res;
+    keys->insert(keys->end(), kJpegRTags.begin() + offset, kJpegRTags.begin() + offset + 3);
+    return OK;
+}
+} // namespace
+
+bool containsCameraId(std::string_view cameraIds, std::string_view cameraId) {
+    if (cameraId.empty()) return false;
+    while (!cameraIds.empty()) {
+        auto end = cameraIds.find(',');
+        if (cameraIds.substr(0, end) == cameraId) return true;
+        if (end == std::string_view::npos) break;
+        cameraIds.remove_prefix(end + 1);
+    }
+    return false;
+}
+
+bool isEnabled(const std::string& cameraId) {
+    return containsCameraId(base::GetProperty(kCameraIdsProperty, ""), cameraId);
+}
+
+bool supportsConcurrentJpeg(const CameraMetadata& info, int64_t profile) {
+    auto caps = info.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+    if (caps.count == 0 || std::find(caps.data.u8, caps.data.u8 + caps.count,
+            ANDROID_REQUEST_AVAILABLE_CAPABILITIES_DYNAMIC_RANGE_TEN_BIT) ==
+            caps.data.u8 + caps.count) return false;
+    auto profiles = info.find(ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP);
+    if (profiles.count == 0 || profiles.count % 3) return false;
+    for (size_t i = 0; i < profiles.count; i += 3) {
+        if (profiles.data.i64[i] == profile) {
+            return profiles.data.i64[i+1] == 0 || (profiles.data.i64[i+1] & kStandard) != 0;
+        }
+    }
+    return false;
+}
+
+bool supportsJpegColorSpace(const CameraMetadata& info, int32_t colorSpace) {
+    if (colorSpace == ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_UNSPECIFIED) return true;
+    // API3's compressed SDR intent supports sRGB or Display P3, not arbitrary HDR gamuts.
+    if (colorSpace != ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_SRGB &&
+            colorSpace != ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_DISPLAY_P3) return false;
+    auto colors = info.find(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP);
+    if (colors.count % 3) return false;
+    for (size_t i = 0; i < colors.count; i += 3) {
+        if (colors.data.i64[i] == colorSpace &&
+                (colors.data.i64[i+1] == static_cast<int64_t>(PublicFormat::JPEG) ||
+                 colors.data.i64[i+1] == static_cast<int64_t>(PublicFormat::UNKNOWN)) &&
+                (colors.data.i64[i+2] & kStandard)) return true;
+    }
+    return false;
+}
+
+status_t deriveCharacteristics(CameraMetadata* info) {
+    if (info == nullptr || !supportsConcurrentJpeg(*info, kHlg)) return BAD_VALUE;
+    const CameraMetadata& original = *info;
+    auto keys = original.find(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS);
+    auto maxSize = original.find(ANDROID_JPEG_MAX_SIZE);
+    auto colors = original.find(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP);
+    if (keys.count == 0 || maxSize.count != 1 || maxSize.data.i32[0] <= 0 || colors.count % 3) {
+        return BAD_VALUE;
+    }
+
+    CameraMetadata candidate(original);
+    std::vector<int32_t> newKeys;
+    for (size_t i = 0; i < keys.count; ++i) {
+        if (std::find(kJpegRTags.begin(), kJpegRTags.end(), keys.data.i32[i]) == kJpegRTags.end()) {
+            newKeys.push_back(keys.data.i32[i]);
+        }
+    }
+    for (uint32_t tag : kJpegRTags) {
+        status_t res = candidate.erase(tag);
+        if (res != OK) return res;
+    }
+    status_t res = deriveMode(&candidate, false, &newKeys);
+    if (res != OK) return res;
+    auto caps = original.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+    if (std::find(caps.data.u8, caps.data.u8 + caps.count,
+            ANDROID_REQUEST_AVAILABLE_CAPABILITIES_ULTRA_HIGH_RESOLUTION_SENSOR) !=
+            caps.data.u8 + caps.count) {
+        res = deriveMode(&candidate, true, &newKeys);
+        if (res != OK) return res;
+    }
+
+    // Drop native JPEG_R color declarations. Explicit output color support must
+    // come from the HAL JPEG stream; YUV sRGB is not evidence for JPEG sRGB.
+    std::vector<int64_t> newColors;
+    for (size_t i = 0; i < colors.count; i += 3) {
+        if (colors.data.i64[i+1] != static_cast<int64_t>(PublicFormat::JPEG_R)) {
+            newColors.insert(newColors.end(), colors.data.i64 + i, colors.data.i64 + i + 3);
+        }
+    }
+    // STANDARD public JPEG_R requests select internal HLG. Advertise HLG only
+    // in addition to STANDARD; other profiles require separate validation.
+    for (int64_t color : {ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_SRGB,
+                         ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_DISPLAY_P3}) {
+        if (supportsJpegColorSpace(original, color)) {
+            newColors.insert(newColors.end(), {color, static_cast<int64_t>(PublicFormat::JPEG_R),
+                    kStandard | kHlg});
+        }
+    }
+    if (colors.count > 0) {
+        if (newColors.empty()) {
+            res = candidate.erase(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP);
+            newKeys.erase(std::remove(newKeys.begin(), newKeys.end(),
+                    ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP), newKeys.end());
+        } else {
+            res = candidate.update(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP,
+                    newColors.data(), newColors.size());
+        }
+        if (res != OK) return res;
+    }
+    std::sort(newKeys.begin(), newKeys.end());
+    newKeys.erase(std::unique(newKeys.begin(), newKeys.end()), newKeys.end());
+    res = candidate.update(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS,
+            newKeys.data(), newKeys.size());
+    if (res != OK) return res;
+    *info = std::move(candidate);
+    return OK;
+}
+
+status_t getP010FullRange(android_dataspace dataSpace, bool* fullRange) {
+    if (fullRange == nullptr) return BAD_VALUE;
+    switch (dataSpace & HAL_DATASPACE_RANGE_MASK) {
+        case HAL_DATASPACE_RANGE_FULL: *fullRange = true; return OK;
+        case HAL_DATASPACE_RANGE_LIMITED: *fullRange = false; return OK;
+        default: return BAD_VALUE;
+    }
+}
+} // namespace android::camera3::JpegRCompositeUtils
