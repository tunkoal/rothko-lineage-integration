+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "../utils/JpegRCompositeUtils.h"
+
+#include <gtest/gtest.h>
+#include <iterator>
+#include <system/camera_metadata.h>
+#include <ui/PublicFormat.h>
+#include <vector>
+
+namespace android::camera3::JpegRCompositeUtils {
+namespace {
+constexpr int64_t kStandard = ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP_STANDARD;
+constexpr int64_t kHlg = ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP_HLG10;
+
+CameraMetadata makeMetadata() {
+    CameraMetadata info;
+    const uint8_t caps[] = {ANDROID_REQUEST_AVAILABLE_CAPABILITIES_DYNAMIC_RANGE_TEN_BIT};
+    const int64_t profiles[] = {kHlg, kStandard | kHlg, 0};
+    const int32_t configs[] = {HAL_PIXEL_FORMAT_BLOB, 640, 480, 0,
+            HAL_PIXEL_FORMAT_YCBCR_P010, 640, 480, 0, HAL_PIXEL_FORMAT_BLOB, 1280, 720, 0};
+    const int64_t minimums[] = {HAL_PIXEL_FORMAT_BLOB, 640, 480, 100,
+            HAL_PIXEL_FORMAT_YCBCR_P010, 640, 480, 110,
+            HAL_PIXEL_FORMAT_BLOB, 1280, 720, 100};
+    const int64_t stalls[] = {HAL_PIXEL_FORMAT_BLOB, 640, 480, 1000,
+            HAL_PIXEL_FORMAT_BLOB, 1280, 720, 1000};
+    const int32_t nativeJpegR[] = {HAL_PIXEL_FORMAT_BLOB, 1280, 720, 0};
+    const int64_t colors[] = {ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_SRGB,
+            static_cast<int64_t>(PublicFormat::JPEG_R), kStandard | kHlg,
+            ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_SRGB,
+            static_cast<int64_t>(PublicFormat::YUV_420_888), kStandard};
+    const int32_t maxSize[] = {1024 * 1024};
+    const int32_t keys[] = {ANDROID_REQUEST_AVAILABLE_CAPABILITIES,
+            ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP,
+            ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS,
+            ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,
+            ANDROID_SCALER_AVAILABLE_STALL_DURATIONS,
+            ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS,
+            ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP, ANDROID_JPEG_MAX_SIZE};
+    EXPECT_EQ(OK, info.update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES, caps, std::size(caps)));
+    EXPECT_EQ(OK, info.update(ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP,
+            profiles, std::size(profiles)));
+    EXPECT_EQ(OK, info.update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS,
+            configs, std::size(configs)));
+    EXPECT_EQ(OK, info.update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,
+            minimums, std::size(minimums)));
+    EXPECT_EQ(OK, info.update(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS,
+            stalls, std::size(stalls)));
+    EXPECT_EQ(OK, info.update(ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS,
+            nativeJpegR, std::size(nativeJpegR)));
+    EXPECT_EQ(OK, info.update(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP,
+            colors, std::size(colors)));
+    EXPECT_EQ(OK, info.update(ANDROID_JPEG_MAX_SIZE, maxSize, std::size(maxSize)));
+    EXPECT_EQ(OK, info.update(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS, keys, std::size(keys)));
+    return info;
+}
+
+std::vector<uint8_t> bytes(CameraMetadata& info) {
+    const auto* buffer = info.getAndLock();
+    const auto* start = reinterpret_cast<const uint8_t*>(buffer);
+    std::vector<uint8_t> result(start, start + get_camera_metadata_size(buffer));
+    info.unlock(buffer);
+    return result;
+}
+
+TEST(JpegRCompositeUtilsTest, CameraIdsMustMatchWholeTokensAndDefaultIsEmpty) {
+    EXPECT_FALSE(containsCameraId("", "0"));
+    EXPECT_FALSE(containsCameraId("0,1", ""));
+    EXPECT_TRUE(containsCameraId("0,1", "1"));
+    EXPECT_FALSE(containsCameraId("10,11", "1"));
+    EXPECT_FALSE(containsCameraId("0,1", "2"));
+}
+
+TEST(JpegRCompositeUtilsTest, KeepsOnlyRealSizeIntersectionAndDoesNotInventJpegColorSpace) {
+    auto info = makeMetadata();
+    ASSERT_EQ(OK, deriveCharacteristics(&info));
+    const CameraMetadata& readOnly = info;
+    auto streams = readOnly.find(ANDROID_JPEGR_AVAILABLE_JPEG_R_STREAM_CONFIGURATIONS);
+    ASSERT_EQ(4u, streams.count);
+    EXPECT_EQ(640, streams.data.i32[1]);
+    EXPECT_EQ(480, streams.data.i32[2]);
+    auto minimums = readOnly.find(ANDROID_JPEGR_AVAILABLE_JPEG_R_MIN_FRAME_DURATIONS);
+    ASSERT_EQ(4u, minimums.count);
+    EXPECT_EQ(110, minimums.data.i64[3]);
+    auto colors = readOnly.find(ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP);
+    ASSERT_EQ(3u, colors.count);
+    EXPECT_EQ(static_cast<int64_t>(PublicFormat::YUV_420_888), colors.data.i64[1]);
+    EXPECT_FALSE(supportsJpegColorSpace(info,
+            ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_SRGB));
+    EXPECT_TRUE(supportsJpegColorSpace(info,
+            ANDROID_REQUEST_AVAILABLE_COLOR_SPACE_PROFILES_MAP_UNSPECIFIED));
+}
+
+TEST(JpegRCompositeUtilsTest, FailureLeavesAllNativeMetadataUntouched) {
+    auto info = makeMetadata();
+    ASSERT_EQ(OK, info.erase(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS));
+    const auto before = bytes(info);
+    EXPECT_EQ(BAD_VALUE, deriveCharacteristics(&info));
+    EXPECT_EQ(before, bytes(info));
+}
+
+TEST(JpegRCompositeUtilsTest, RefusesHdrOnlyWithoutConcurrentSdrInsteadOfEnablingApi0) {
+    auto info = makeMetadata();
+    const int64_t profiles[] = {kHlg, kHlg, 0};
+    ASSERT_EQ(OK, info.update(ANDROID_REQUEST_AVAILABLE_DYNAMIC_RANGE_PROFILES_MAP,
+            profiles, std::size(profiles)));
+    const auto before = bytes(info);
+    EXPECT_FALSE(supportsConcurrentJpeg(info, kHlg));
+    EXPECT_EQ(BAD_VALUE, deriveCharacteristics(&info));
+    EXPECT_EQ(before, bytes(info));
+}
+
+TEST(JpegRCompositeUtilsTest, UsesOnlyExplicitFullOrLimitedBufferRanges) {
+    bool full = false;
+    EXPECT_EQ(OK, getP010FullRange(static_cast<android_dataspace>(
+            HAL_DATASPACE_BT2020_HLG | HAL_DATASPACE_RANGE_FULL), &full));
+    EXPECT_TRUE(full);
+    EXPECT_EQ(OK, getP010FullRange(HAL_DATASPACE_BT2020_ITU_HLG, &full));
+    EXPECT_FALSE(full);
+    EXPECT_EQ(BAD_VALUE, getP010FullRange(HAL_DATASPACE_UNKNOWN, &full));
+    EXPECT_EQ(BAD_VALUE, getP010FullRange(HAL_DATASPACE_BT2020_ITU_HLG, nullptr));
+}
+} // namespace
+} // namespace android::camera3::JpegRCompositeUtils
