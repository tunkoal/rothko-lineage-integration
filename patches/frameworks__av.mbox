diff --git a/services/camera/libcameraservice/tests/JpegRCompositeOrientationTest.cpp b/services/camera/libcameraservice/tests/JpegRCompositeOrientationTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..865f2f7e823bbcc66278e5b5f7c02d05025149a2
--- /dev/null
+++ b/services/camera/libcameraservice/tests/JpegRCompositeOrientationTest.cpp
@@ -0,0 +1,135 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "../utils/JpegRCompositeOrientation.h"
+
+#include <array>
+#include <cstdlib>
+#include <cstdio>
+#include <gtest/gtest.h>
+#include <jpeglib.h>
+#include <vector>
+
+namespace android::camera3::JpegRCompositeUtils {
+namespace {
+
+// A real, small RGB JPEG with an optional explicit TIFF orientation. No private
+// photographs are included in the test. Only JPEG headers are used by alignment.
+std::vector<uint8_t> makeJpeg(unsigned int width, unsigned int height, int exifOrientation) {
+    jpeg_compress_struct encoder{};
+    jpeg_error_mgr error{};
+    encoder.err = jpeg_std_error(&error);
+    jpeg_create_compress(&encoder);
+    unsigned char* bytes = nullptr;
+    unsigned long size = 0;
+    jpeg_mem_dest(&encoder, &bytes, &size);
+    encoder.image_width = width;
+    encoder.image_height = height;
+    encoder.input_components = 3;
+    encoder.in_color_space = JCS_RGB;
+    jpeg_set_defaults(&encoder);
+    jpeg_start_compress(&encoder, TRUE);
+    if (exifOrientation >= 0) {
+        const uint8_t exif[] = {'E', 'x', 'i', 'f', 0, 0, 'I', 'I', 42, 0, 8, 0, 0, 0,
+                1, 0, 0x12, 1, 3, 0, 1, 0, 0, 0,
+                static_cast<uint8_t>(exifOrientation), 0, 0, 0, 0, 0, 0, 0};
+        jpeg_write_marker(&encoder, JPEG_APP0 + 1, exif, sizeof(exif));
+    }
+    std::vector<uint8_t> row(width * 3, 128);
+    while (encoder.next_scanline < height) {
+        JSAMPROW ptr = row.data();
+        jpeg_write_scanlines(&encoder, &ptr, 1);
+    }
+    jpeg_finish_compress(&encoder);
+    std::vector<uint8_t> result(bytes, bytes + size);
+    jpeg_destroy_compress(&encoder);
+    free(bytes);
+    return result;
+}
+
+struct Input {
+    // Visible 4x2, with stride padding that must not become image pixels.
+    alignas(4) std::array<uint16_t, 16> y{64, 128, 192, 256, 999, 999, 999, 999,
+            320, 384, 448, 512, 999, 999, 999, 999};
+    alignas(4) std::array<uint16_t, 8> uv{704, 768, 1344, 1408, 999, 999, 999, 999};
+    ultrahdr::jpegr_uncompressed_struct raw{};
+    Input() {
+        raw.width = 4;
+        raw.height = 2;
+        raw.data = y.data();
+        raw.chroma_data = uv.data();
+        raw.luma_stride = raw.chroma_stride = 8;
+        raw.colorGamut = ultrahdr::ULTRAHDR_COLORGAMUT_BT2100;
+        raw.colorRange = UHDR_CR_FULL_RANGE;
+    }
+};
+
+TEST(JpegRCompositeOrientationTest, RotatesBothPlanesAndPreservesCompressedBaseAndRange) {
+    const std::array<int, 4> angles{0, 90, 180, 270};
+    const std::array<std::array<uint16_t, 8>, 4> expectedY{{
+            {64, 128, 192, 256, 320, 384, 448, 512},
+            {320, 64, 384, 128, 448, 192, 512, 256},
+            {512, 448, 384, 320, 256, 192, 128, 64},
+            {256, 512, 192, 448, 128, 384, 64, 320}}};
+    const std::array<std::array<uint16_t, 4>, 4> expectedUV{{
+            {704, 768, 1344, 1408}, {704, 768, 1344, 1408},
+            {1344, 1408, 704, 768}, {1344, 1408, 704, 768}}};
+    for (size_t index = 0; index < angles.size(); ++index) {
+        for (int mirror : {0, 1, 2}) {
+            Input input;
+            const bool swap = angles[index] == 90 || angles[index] == 270;
+            const unsigned int width = swap ? 2 : 4, height = swap ? 4 : 2;
+            auto jpeg = makeJpeg(width, height, mirror);
+            const auto savedJpeg = jpeg;
+            std::unique_ptr<ultrahdr::uhdr_raw_image_ext_t> storage;
+            ASSERT_EQ(OK, alignP010WithPixelRotatedJpeg(angles[index], jpeg.data(), jpeg.size(),
+                    &input.raw, &storage));
+            ASSERT_EQ(width, input.raw.width);
+            ASSERT_EQ(height, input.raw.height);
+            EXPECT_EQ(UHDR_CR_FULL_RANGE, input.raw.colorRange);
+            const auto* y = static_cast<uint16_t*>(input.raw.data);
+            const auto* uv = static_cast<uint16_t*>(input.raw.chroma_data);
+            for (unsigned int row = 0; row < height; ++row) {
+                for (unsigned int col = 0; col < width; ++col) {
+                    EXPECT_EQ(expectedY[index][row * width + col],
+                            y[row * input.raw.luma_stride + col]);
+                }
+            }
+            for (unsigned int row = 0; row < height / 2; ++row) {
+                for (unsigned int col = 0; col < width; ++col) {
+                    EXPECT_EQ(expectedUV[index][row * width + col],
+                            uv[row * input.raw.chroma_stride + col]);
+                }
+            }
+            EXPECT_EQ(savedJpeg, jpeg);
+        }
+    }
+}
+
+TEST(JpegRCompositeOrientationTest, RejectsContradictoryOrMissingOrientationWithoutMutation) {
+    for (int exif : {-1, 3, 5, 6, 7, 8}) {
+        Input input;
+        auto jpeg = makeJpeg(2, 4, exif);
+        const auto* original = input.raw.data;
+        std::unique_ptr<ultrahdr::uhdr_raw_image_ext_t> storage;
+        EXPECT_EQ(BAD_VALUE, alignP010WithPixelRotatedJpeg(90, jpeg.data(), jpeg.size(),
+                &input.raw, &storage));
+        EXPECT_EQ(original, input.raw.data);
+        EXPECT_EQ(nullptr, storage);
+    }
+    Input input;
+    auto jpeg = makeJpeg(4, 2, 1);
+    std::unique_ptr<ultrahdr::uhdr_raw_image_ext_t> storage;
+    EXPECT_EQ(BAD_VALUE, alignP010WithPixelRotatedJpeg(90, jpeg.data(), jpeg.size(),
+            &input.raw, &storage));
+    EXPECT_EQ(BAD_VALUE, alignP010WithPixelRotatedJpeg(45, jpeg.data(), jpeg.size(),
+            &input.raw, &storage));
+    input.raw.chroma_stride = 5;
+    EXPECT_EQ(BAD_VALUE, alignP010WithPixelRotatedJpeg(0, jpeg.data(), jpeg.size(),
+            &input.raw, &storage));
+}
+
+} // namespace
+} // namespace android::camera3::JpegRCompositeUtils
diff --git a/services/camera/libcameraservice/utils/JpegRCompositeOrientation.cpp b/services/camera/libcameraservice/utils/JpegRCompositeOrientation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0cbb49d879b0fabb014a4050c241ad2dd3f56f0b
--- /dev/null
+++ b/services/camera/libcameraservice/utils/JpegRCompositeOrientation.cpp
@@ -0,0 +1,96 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "JpegRCompositeOrientation.h"
+
+#include <libexif/exif-data.h>
+#include <libexif/exif-utils.h>
+#include <limits>
+#include <ultrahdr/editorhelper.h>
+#include <ultrahdr/jpegdecoderhelper.h>
+
+namespace android::camera3::JpegRCompositeUtils {
+
+status_t alignP010WithPixelRotatedJpeg(int32_t orientation, const void* jpeg, size_t jpegSize,
+        ultrahdr::jpegr_uncompressed_struct* p010,
+        std::unique_ptr<ultrahdr::uhdr_raw_image_ext_t>* storage) {
+    if (p010 == nullptr || storage == nullptr || *storage != nullptr || jpeg == nullptr ||
+            jpegSize == 0 || jpegSize > std::numeric_limits<unsigned int>::max() ||
+            p010->data == nullptr || p010->chroma_data == nullptr ||
+            p010->width == 0 || p010->height == 0 || (p010->width & 1) || (p010->height & 1) ||
+            p010->width > static_cast<unsigned int>(ultrahdr::kMaxWidth) ||
+            p010->height > static_cast<unsigned int>(ultrahdr::kMaxHeight) ||
+            p010->luma_stride < p010->width || p010->chroma_stride < p010->width ||
+            (p010->chroma_stride & 1) ||
+            reinterpret_cast<uintptr_t>(p010->chroma_data) % alignof(uint32_t) != 0 ||
+            (p010->colorRange != UHDR_CR_FULL_RANGE &&
+             p010->colorRange != UHDR_CR_LIMITED_RANGE) ||
+            (orientation != 0 && orientation != 90 && orientation != 180 && orientation != 270)) {
+        return BAD_VALUE;
+    }
+
+    ultrahdr::JpegDecoderHelper decoder;
+    if (decoder.parseImage(jpeg, jpegSize).error_code != UHDR_CODEC_OK) return BAD_VALUE;
+    const bool swapDimensions = orientation == 90 || orientation == 270;
+    const auto width = swapDimensions ? p010->height : p010->width;
+    const auto height = swapDimensions ? p010->width : p010->height;
+    if (decoder.getDecompressedImageWidth() != width ||
+            decoder.getDecompressedImageHeight() != height) return BAD_VALUE;
+
+    // A pixel-rotating HAL must not also ask the consumer to rotate through
+    // EXIF. Stock may use 0 (undefined), 1 (normal), or 2 (horizontal mirror).
+    // A mirror remains attached to both the base and gain map; do not bake it
+    // into P010 a second time. Require explicit EXIF for nonzero rotations.
+    bool hasOrientation = false;
+    if (decoder.getEXIFSize() > 0) {
+        if (decoder.getEXIFSize() > std::numeric_limits<unsigned int>::max()) return BAD_VALUE;
+        std::unique_ptr<ExifData, decltype(&exif_data_unref)> exif(exif_data_new(), exif_data_unref);
+        if (!exif) return BAD_VALUE;
+        // Do not let libexif insert a default orientation into an absent tag.
+        exif_data_unset_option(exif.get(), EXIF_DATA_OPTION_FOLLOW_SPECIFICATION);
+        exif_data_load_data(exif.get(), static_cast<const unsigned char*>(decoder.getEXIFPtr()),
+                decoder.getEXIFSize());
+        const auto* entry = exif_content_get_entry(exif->ifd[EXIF_IFD_0], EXIF_TAG_ORIENTATION);
+        if (entry != nullptr) {
+            if (entry->format != EXIF_FORMAT_SHORT || entry->components != 1 ||
+                    entry->data == nullptr || entry->size < 2) return BAD_VALUE;
+            const auto exifOrientation = exif_get_short(entry->data,
+                    exif_data_get_byte_order(exif.get()));
+            if (exifOrientation > 2) return BAD_VALUE;
+            hasOrientation = true;
+        }
+    }
+    if (orientation != 0 && !hasOrientation) return BAD_VALUE;
+    if (orientation == 0) return OK;
+
+    uhdr_raw_image_t raw{};
+    raw.fmt = UHDR_IMG_FMT_24bppYCbCrP010;
+    raw.cg = UHDR_CG_BT_2100;
+    // The opt-in composite route only accepts HLG10 (or STANDARD mapped to it).
+    raw.ct = UHDR_CT_HLG;
+    raw.range = p010->colorRange;
+    raw.w = p010->width;
+    raw.h = p010->height;
+    raw.planes[UHDR_PLANE_Y] = p010->data;
+    raw.planes[UHDR_PLANE_UV] = p010->chroma_data;
+    raw.stride[UHDR_PLANE_Y] = p010->luma_stride;
+    raw.stride[UHDR_PLANE_UV] = p010->chroma_stride;
+    ultrahdr::uhdr_rotate_effect_t effect(orientation);
+    auto rotated = ultrahdr::apply_rotate(&effect, &raw);
+    if (!rotated || rotated->w != width || rotated->h != height ||
+            rotated->planes[UHDR_PLANE_Y] == nullptr ||
+            rotated->planes[UHDR_PLANE_UV] == nullptr) return NO_MEMORY;
+
+    p010->width = rotated->w;
+    p010->height = rotated->h;
+    p010->data = rotated->planes[UHDR_PLANE_Y];
+    p010->chroma_data = rotated->planes[UHDR_PLANE_UV];
+    p010->luma_stride = rotated->stride[UHDR_PLANE_Y];
+    p010->chroma_stride = rotated->stride[UHDR_PLANE_UV];
+    *storage = std::move(rotated);
+    return OK;
+}
+
+} // namespace android::camera3::JpegRCompositeUtils
