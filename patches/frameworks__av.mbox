+#include <ultrahdr/ultrahdrcommon.h>
+#include <utils/Errors.h>
+
+namespace android::camera3::JpegRCompositeUtils {
+
+// Only for an explicitly selected HAL that physically rotates its JPEG pixels
+// by JPEG_ORIENTATION while leaving P010 in sensor coordinates. This is not
+// inferred from an aspect ratio: 180-degree and square captures are ambiguous.
+// The compressed JPEG (including its EXIF/mirror flag) is never rewritten.
+status_t alignP010WithPixelRotatedJpeg(int32_t orientation, const void* jpeg, size_t jpegSize,
+        ultrahdr::jpegr_uncompressed_struct* p010,
+        std::unique_ptr<ultrahdr::uhdr_raw_image_ext_t>* storage);
+
+} // namespace android::camera3::JpegRCompositeUtils
